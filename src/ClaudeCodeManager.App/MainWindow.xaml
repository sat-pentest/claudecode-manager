<Window x:Class="ClaudeCodeManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ClaudeCodeManager.App.ViewModels"
        xmlns:views="clr-namespace:ClaudeCodeManager.App.Views"
        xmlns:svc="clr-namespace:ClaudeCodeManager.App.Services"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="CLAUDECODE MANAGER"
        Height="820" Width="1340" MinHeight="640" MinWidth="1100"
        Background="{StaticResource B.BG.Primary}"
        Foreground="{StaticResource B.Text}"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/icon.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        BorderBrush="{StaticResource B.Border}"
        BorderThickness="1"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="62"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HarnessViewModel}">
            <views:HarnessView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClaudeMdViewModel}">
            <views:ClaudeMdView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MemoryViewModel}">
            <views:MemoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SkillsViewModel}">
            <views:SkillsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AgentsViewModel}">
            <views:AgentsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:SearchView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:McpStatusViewModel}">
            <views:McpStatusView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SessionsViewModel}">
            <views:SessionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SnapshotsViewModel}">
            <views:SnapshotsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
            <views:DiagnosticsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <Border Grid.Row="0" Background="{StaticResource B.BG.Panel}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Image Source="Assets/icon.ico" Width="34" Height="34" Margin="0,0,14,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <!-- CLAUDECODE with scanning ember glow behind (clipped to text width so glow stops at E edge) -->
                        <Grid>
                            <!-- Ellipse container: sized to match text width, OpacityMask softens top/bottom -->
                            <Border ClipToBounds="True"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Width="{Binding ActualWidth, ElementName=TitleText, Converter={x:Static vm:SubtractDoubleConverter.Instance}, ConverterParameter=2}"
                                    Height="28">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="#40000000" Offset="0.25"/>
                                        <GradientStop Color="Black" Offset="0.5"/>
                                        <GradientStop Color="#40000000" Offset="0.75"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                                <Ellipse x:Name="ScanEllipse"
                                         IsHitTestVisible="False"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Width="160" Height="80"
                                         Opacity="0.55">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                            <GradientStop Color="{StaticResource C.Ember}" Offset="0"/>
                                            <GradientStop Color="#40F26A2E" Offset="0.55"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="26"/>
                                    </Ellipse.Effect>
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ScanTranslate" X="-160"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <TextBlock x:Name="TitleText" Text="CLAUDECODE" Style="{StaticResource T.Pixel.Title}" FontSize="15" VerticalAlignment="Center"/>
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="ScanTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             From="-160" To="220"
                                                             Duration="0:0:4.5">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                        </Grid>
                        <TextBlock Text="MANAGER  ▌  v1.0" Style="{StaticResource T.Pixel.Section}" FontSize="8" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Command="{Binding OpenClaudeRootCommand}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Cursor="Hand" Padding="10,4"
                        ToolTip="Open ~/.claude/ folder in Explorer">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" TargetName="Bd" Value="{StaticResource B.BG.Hover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Margin="0,0,8,0"
                                 svc:PulseBehavior.IsActive="{Binding ClaudeRootExists}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource B.Success}"/>
                                    <Setter Property="Effect" Value="{StaticResource Glow.Soft}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ClaudeRootExists}" Value="False">
                                            <Setter Property="Fill" Value="{StaticResource B.Danger}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Style="{StaticResource T.Mono}" Foreground="{StaticResource B.TextMuted}" Text="{Binding ClaudeRootPath}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Pixel}" Content="SNAPSHOT" Command="{Binding QuickSnapshotCommand}" Margin="0,0,12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource Btn.Caption}" Content="—" Click="Caption_Minimize" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource Btn.Caption}" Content="▢" Click="Caption_MaxRestore" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource Btn.Caption.Close}" Content="✕" Click="Caption_Close" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="186" MinWidth="120"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="480"/>
            </Grid.ColumnDefinitions>

            <!-- NAV RAIL -->
            <Border Background="{StaticResource B.BG.Panel}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="◢ MODULES" Style="{StaticResource T.Pixel.Section}" FontSize="9" Margin="20,18,0,12"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Modules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource Btn.Nav}"
                                              Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}">
                                    <ToggleButton.IsChecked>
                                        <MultiBinding Mode="OneWay" Converter="{x:Static views:ReferenceEqualsMultiConverter.Instance}">
                                            <Binding/>
                                            <Binding Path="DataContext.Current" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </ToggleButton.IsChecked>
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="20" Height="20" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <Path x:Name="NavIcon"
                                                  Data="{Binding Glyph, Converter={x:Static vm:StringToGeometry.Instance}}"
                                                  StrokeThickness="1.8"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Fill="Transparent"
                                                  Stretch="Uniform"
                                                  Width="20" Height="20">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Stroke" Value="{StaticResource B.Rust}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                                <Setter Property="Stroke" Value="{StaticResource B.Ember}"/>
                                                                <Setter Property="Effect" Value="{StaticResource Glow.Soft}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Grid>
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource Splitter.Vertical}"/>

            <!-- CONTENT -->
            <ContentControl Grid.Column="2" Content="{Binding Current}" Margin="0"/>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource B.BG.Panel}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="{Binding Current.Title}" Style="{StaticResource T.Pixel.Section}" FontSize="8"/>
                    <TextBlock Text="  ▌  " Foreground="{StaticResource B.RustDim}" VerticalAlignment="Center" Margin="6,0"/>
                    <TextBlock Text="{Binding Current.Status}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.TextMuted}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ExternalChangeNotice}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Warn}" VerticalAlignment="Center" Margin="0,0,20,0"/>
            </Grid>
        </Border>

        <!-- TRAY -->
        <tb:TaskbarIcon x:Name="Tray"
                        IconSource="Assets/icon.ico"
                        ToolTipText="ClaudeCode Manager"
                        TrayLeftMouseUp="Tray_LeftClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show window" Click="Tray_ShowClick"/>
                    <MenuItem Header="Snapshot now" Click="Tray_SnapshotClick"/>
                    <Separator/>
                    <MenuItem Header="Exit" Click="Tray_ExitClick"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
