<Window x:Class="ClaudeCodeManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ClaudeCodeManager.App.ViewModels"
        xmlns:views="clr-namespace:ClaudeCodeManager.App.Views"
        xmlns:svc="clr-namespace:ClaudeCodeManager.App.Services"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="CLAUDECODE MANAGER"
        Height="820" Width="1340" MinHeight="640" MinWidth="1100"
        Background="{StaticResource B.BG.Primary}"
        Foreground="{StaticResource B.Text}"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/icon.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        BorderBrush="{StaticResource B.Border}"
        BorderThickness="1"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        FontFamily="{StaticResource Font.UI}" FontSize="13">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="62"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HarnessViewModel}">
            <views:HarnessView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClaudeMdViewModel}">
            <views:ClaudeMdView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MemoryViewModel}">
            <views:MemoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SkillsViewModel}">
            <views:SkillsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AgentsViewModel}">
            <views:AgentsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WorkflowsViewModel}">
            <views:WorkflowsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:SearchView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:McpStatusViewModel}">
            <views:McpStatusView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SessionsViewModel}">
            <views:SessionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CostViewModel}">
            <views:CostView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScheduleViewModel}">
            <views:ScheduleView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SnapshotsViewModel}">
            <views:SnapshotsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
            <views:DiagnosticsView/>
        </DataTemplate>

        <!--
            One nav row. Lifted out of the rail so both the flat list and the grouped sections use
            the same markup; the rows themselves did not change when grouping arrived.
        -->
        <DataTemplate x:Key="NavRowTemplate">
            <!--
                A Button, not a ToggleButton. The row has no state of its own to flip: which module
                is current is the shell's answer, and the row reads IsCurrent to display it.
            -->
            <Button Style="{StaticResource Btn.Nav}"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Title}">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="20" Height="20" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Path x:Name="NavIcon"
                              Data="{Binding Glyph, Converter={x:Static vm:StringToGeometry.Instance}}"
                              StrokeThickness="1.8"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Fill="Transparent"
                              Stretch="Uniform"
                              Width="20" Height="20">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Stroke" Value="{StaticResource B.Rust}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource B.Ember}"/>
                                            <Setter Property="Effect" Value="{StaticResource Glow.Soft}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <Border Grid.Row="0" Background="{StaticResource B.BG.Panel}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Image Source="Assets/icon.ico" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <!-- CLAUDECODE with scanning ember glow behind (clipped to text width so glow stops at E edge) -->
                        <Grid>
                            <!-- Ellipse container: sized to match text width, OpacityMask softens top/bottom -->
                            <Border ClipToBounds="True"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Width="{Binding ActualWidth, ElementName=TitleText, Converter={x:Static vm:SubtractDoubleConverter.Instance}, ConverterParameter=2}"
                                    Height="24">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="#40000000" Offset="0.25"/>
                                        <GradientStop Color="Black" Offset="0.5"/>
                                        <GradientStop Color="#40000000" Offset="0.68"/>
                                        <GradientStop Color="Transparent" Offset="0.88"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                                <Ellipse x:Name="ScanEllipse"
                                         IsHitTestVisible="False"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Width="160" Height="80"
                                         Opacity="0.55">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                            <GradientStop Color="{StaticResource C.Ember}" Offset="0"/>
                                            <GradientStop Color="#4DF26A2E" Offset="0.55"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="25"/>
                                    </Ellipse.Effect>
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ScanTranslate" X="-160"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                            <TextBlock x:Name="TitleText" Text="CLAUDECODE" Style="{StaticResource T.Pixel.Title}" FontSize="21" VerticalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect x:Name="TitleGlow" Color="{StaticResource C.Ember}"
                                                      BlurRadius="14" ShadowDepth="0" Opacity="0.75"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- sweep: 스캔 글로우가 글자를 훑고 지나감 (원래 속도 유지) -->
                                            <DoubleAnimation Storyboard.TargetName="ScanTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             From="-160" To="220"
                                                             Duration="0:0:4.5"
                                                             RepeatBehavior="Forever">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <!-- ember 미세 명멸 -->
                                            <DoubleAnimation Storyboard.TargetName="ScanEllipse"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.5" To="0.68"
                                                             Duration="0:0:2.8"
                                                             AutoReverse="True"
                                                             RepeatBehavior="Forever">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <!-- 글자 글로우 미세 호흡 -->
                                            <DoubleAnimation Storyboard.TargetName="TitleGlow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             From="12" To="17"
                                                             Duration="0:0:2.8"
                                                             AutoReverse="True"
                                                             RepeatBehavior="Forever">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TitleGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.68" To="0.86"
                                                             Duration="0:0:2.8"
                                                             AutoReverse="True"
                                                             RepeatBehavior="Forever">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                        </Grid>
                        <TextBlock Text="MANAGER · v2.0" Style="{StaticResource T.Label}" Margin="1,-1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Command="{Binding OpenClaudeRootCommand}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Cursor="Hand" Padding="10,4"
                        ToolTip="Open ~/.claude/ folder in Explorer">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" TargetName="Bd" Value="{StaticResource B.BG.Hover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Margin="0,0,10,0"
                                 svc:PulseBehavior.IsActive="{Binding ClaudeRootExists}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource B.Success}"/>
                                    <Setter Property="Effect" Value="{StaticResource Glow.Soft}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ClaudeRootExists}" Value="False">
                                            <Setter Property="Fill" Value="{StaticResource B.Danger}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Style="{StaticResource T.Mono}" Foreground="{StaticResource B.TextMuted}" Text="{Binding ClaudeRootPath}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ENV" Style="{StaticResource T.Mono}" FontSize="12"
                               Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding Environments}" SelectedItem="{Binding ActiveEnvironment, Mode=TwoWay}"
                              DisplayMemberPath="Name" Width="124" Margin="0,0,8,0" VerticalAlignment="Center"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"
                              ToolTip="활성 Claude 설정 환경 전환 — PENTEST(~/.claude) · STUDIO(~/.claude-studio). 전환 시 전 모듈이 그 환경을 바라봄"/>
                    <ComboBox ItemsSource="{Binding LaunchTargets}" SelectedItem="{Binding LaunchTarget, Mode=TwoWay}"
                              Width="78" Margin="0,0,6,0" VerticalAlignment="Center"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"
                              ToolTip="세션 실행 대상 — CLI(터미널) 또는 VSCode(편집기 창). VSCode는 새 인스턴스에서만 환경변수가 확실히 적용됨"/>
                    <Button Style="{StaticResource Btn.Pixel}" Content="LAUNCH" Command="{Binding LaunchSessionCommand}"
                            Margin="0,0,12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="선택한 대상(CLI/VSCode)으로 활성 환경 세션 실행 (CLAUDE_CONFIG_DIR 세팅)"/>
                    <Button Style="{StaticResource Btn.Pixel}" Content="SNAPSHOT" Command="{Binding QuickSnapshotCommand}" Margin="0,0,12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource Btn.Caption}" Content="—" Click="Caption_Minimize" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource Btn.Caption}" Content="▢" Click="Caption_MaxRestore" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource Btn.Caption.Close}" Content="✕" Click="Caption_Close" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" MinWidth="140"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="480"/>
            </Grid.ColumnDefinitions>

            <!-- NAV RAIL -->
            <Border Background="{StaticResource B.BG.Panel}" BorderThickness="0">
                <DockPanel LastChildFill="True" Margin="0,11,0,0">
                    <!--
                        Module filter, docked at the foot of the rail. Fifteen rows across four
                        sections is two steps to reach anything; typing is one. It sits below the
                        list rather than above it because the list is what the eye goes to first -
                        the box is for the times that fails. A section with no match hides
                        entirely, and any section holding a match opens whether or not it was
                        folded: a result the operator cannot see is the same as no result.
                    -->
                    <Border DockPanel.Dock="Bottom" Margin="14,10,14,12" Padding="8,5"
                            Background="{StaticResource B.BG.Sunken}" CornerRadius="{StaticResource R.Sm}"
                            BorderBrush="{StaticResource B.BorderSoft}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⌕" FontFamily="{StaticResource Font.UI}" FontSize="15"
                                       Foreground="{StaticResource B.RustDim}"
                                       Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1">
                                <TextBox x:Name="ModuleFilterBox"
                                         Text="{Binding ModuleFilter, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         FontSize="13" VerticalAlignment="Center"
                                         AutomationProperties.Name="MODULE FILTER"/>
                                <!-- Placeholder: only while the box is empty and unfocused. -->
                                <TextBlock Text="모듈 검색…" IsHitTestVisible="False"
                                           FontSize="13" VerticalAlignment="Center"
                                           Foreground="{StaticResource B.TextDim}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ModuleFilter}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <!--
                        The gutter goes on the Grid, not on the list. The selection rail is the
                        list's sibling here, so a margin on the list alone shifts the rows out from
                        under the mark that is supposed to be on them.
                    -->
                    <Grid>
                    <!--
                        VerticalAlignment matters here. Inside a ScrollViewer whose content
                        is shorter than the viewport, a stretched ItemsControl keeps the
                        viewport height no matter how many rows it holds - so folding a
                        section never raised SizeChanged and the selection rail stayed on a
                        row that had just been clipped away. Sizing to content is what makes
                        the rail notice.
                    -->
                    <ItemsControl x:Name="NavItems" ItemsSource="{Binding Groups}"
                                  VerticalAlignment="Top">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,2">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMatches}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <!-- Section header. Clicking it folds the section away. -->
                                    <ToggleButton Style="{StaticResource Btn.NavGroup}"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                  ToolTip="{Binding Hint}"
                                                  AutomationProperties.Name="{Binding Title}"
                                                  AutomationProperties.HelpText="{Binding Hint}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!--
                                                No state mark. The rows vanishing is already the
                                                clearest signal a section is shut, so a glyph on
                                                top of it is the same fact twice; brightness
                                                carries it instead. The rules give the section a
                                                width, which is what fifteen flat rows lacked.
                                            -->
                                            <Rectangle Width="10" Height="1" VerticalAlignment="Center"
                                                       Margin="0,1,10,0"
                                                       Fill="{StaticResource B.Border}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"/>
                                            <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center"
                                                       Margin="10,1,0,0"
                                                       Fill="{StaticResource B.Border}"/>
                                        </Grid>
                                    </ToggleButton>

                                    <!--
                                        Body. The attached property animates this border's height
                                        between zero and the measured content height; the border
                                        clips so the rows slide out of sight rather than overlap
                                        the next section on the way.
                                    -->
                                    <Border ClipToBounds="True"
                                            views:NavGroupAnimation.IsOpen="{Binding IsExpanded}">
                                        <ItemsControl ItemsSource="{Binding Visible}"
                                                      ItemTemplate="{StaticResource NavRowTemplate}"/>
                                    </Border>
                                </StackPanel>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        The travelling selection rail. It lives inside the scrolled content and
                        after the ItemsControl, so it scrolls with the rows and paints over them;
                        MainWindow.xaml.cs drives its offset. Hit testing is off so the rows keep
                        receiving clicks through it.
                    -->
                    <Border x:Name="NavRail" Width="3" Height="0" CornerRadius="1.5"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{StaticResource B.Rust}"
                            Effect="{StaticResource Glow.Rust}"
                            IsHitTestVisible="False"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="NavRailScale" ScaleY="1"/>
                                <TranslateTransform x:Name="NavRailOffset" Y="0"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                    </Border>
                    </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource Splitter.Shell}"/>

            <!-- CONTENT -->
            <ContentControl x:Name="ContentHost" Grid.Column="2" Content="{Binding Current}" Margin="0"/>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource B.BG.Panel}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Pixel-font glyphs (Press Start 2P) sit near the top of their em-box,
                     so a plain VerticalAlignment=Center makes them look "raised". Explicit
                     Padding pushes them down a few pixels for optical center in the 28px bar. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="{Binding Current.Title}" Style="{StaticResource T.Pixel.Section}" FontSize="11.5"
                               VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="12" Fill="{StaticResource B.BorderStrong}" VerticalAlignment="Center" Margin="12,0"/>
                    <TextBlock Text="{Binding Current.Status}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ExternalChangeNotice}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Warn}" VerticalAlignment="Center" Margin="0,0,20,0"/>
            </Grid>
        </Border>

        <!-- TRAY -->
        <tb:TaskbarIcon x:Name="Tray"
                        IconSource="Assets/icon.ico"
                        ToolTipText="ClaudeCode Manager"
                        TrayLeftMouseUp="Tray_LeftClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show window" Click="Tray_ShowClick"/>
                    <MenuItem Header="Snapshot now" Click="Tray_SnapshotClick"/>
                    <Separator/>
                    <MenuItem Header="Exit" Click="Tray_ExitClick"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
