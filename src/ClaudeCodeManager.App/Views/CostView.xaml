<UserControl x:Class="ClaudeCodeManager.App.Views.CostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ClaudeCodeManager.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:CostViewModel}"
             mc:Ignorable="d">

    <DockPanel Background="{StaticResource B.BG.Primary}">

        <!-- TOP BAR -->
        <Border DockPanel.Dock="Top" Background="{StaticResource B.BG.Panel}" Padding="16,10"
                BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource Icon.Module}" Data="{Binding Glyph, Converter={x:Static vm:StringToGeometry.Instance}}"/>
                <TextBlock Text="COST" Style="{StaticResource T.Pixel.Section}" VerticalAlignment="Center"/>
                <Button Content="SCAN" Style="{StaticResource Btn.Pixel.Primary}" Command="{Binding ScanCommand}" Margin="16,0,0,0"
                        IsEnabled="{Binding IsScanning, Converter={x:Static vm:InverseBool.Instance}}"/>
                <Button Content="FULL RESCAN" Style="{StaticResource Btn.Pixel}" Command="{Binding RescanFromScratchCommand}" Margin="8,0,0,0"
                        IsEnabled="{Binding IsScanning, Converter={x:Static vm:InverseBool.Instance}}"
                        ToolTip="Drop the per-file cache and re-read every transcript"/>
                <Button Content="RATES" Style="{StaticResource Btn.Pixel}" Command="{Binding OpenPricingFileCommand}" Margin="8,0,0,0"
                        ToolTip="Open token-pricing.json to correct or add model rates"/>
                <TextBlock Text="{Binding ScanProgress}" Style="{StaticResource T.Muted}" FontSize="12" Margin="16,0,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource B.Ember}"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource T.Muted}" FontSize="12" Margin="16,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- HEADLINE -->
        <Border DockPanel.Dock="Top" Background="{StaticResource B.BG.Panel}" Padding="16,14"
                BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding TotalCostText}" FontFamily="{StaticResource Font.CRT}" FontSize="42"
                               Foreground="{StaticResource B.Ember}" VerticalAlignment="Center"/>
                    <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RequestsText}" Style="{StaticResource T.Body}" FontSize="13"/>
                        <TextBlock Text="{Binding CacheShareText}" Style="{StaticResource T.Muted}" FontSize="12" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11"
                           Style="{StaticResource T.Muted}" Foreground="{StaticResource B.TextMuted}"
                           Text="List-price equivalent from Anthropic first-party API rates, reconstructed from session transcripts. Not an invoice, and not what a Claude subscription charges."/>

                <Border Margin="0,10,0,0" Padding="10,7" Background="{StaticResource B.BG.Sunken}"
                        BorderBrush="{StaticResource B.Warn}" BorderThickness="1"
                        Visibility="{Binding HasUnpriced, Converter={x:Static vm:BoolToVisibility.Instance}}">
                    <TextBlock Text="{Binding UnpricedWarning}" Style="{StaticResource T.Muted}" FontSize="12"
                               Foreground="{StaticResource B.Warn}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="300"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: breakdowns -->
            <ScrollViewer Background="{StaticResource B.BG.Panel}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,12,14,20">

                    <TextBlock Text="◢ BY MODEL" Style="{StaticResource T.Pixel.Section}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding ByModel}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,9">
                                    <Grid>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource T.Mono}" FontSize="12"/>
                                        <TextBlock Text="{Binding CostText}" Style="{StaticResource T.Mono}" FontSize="12"
                                                   HorizontalAlignment="Right" Foreground="{StaticResource B.Ember}"/>
                                    </Grid>
                                    <Border Height="7" Margin="0,4,0,0" Background="{StaticResource B.BG.Sunken}" HorizontalAlignment="Stretch">
                                        <Rectangle Height="7" HorizontalAlignment="Left"
                                                   Fill="{StaticResource B.Rust}"
                                                   Width="{Binding Percent, Converter={x:Static vm:PercentToWidthConverter.Instance}, ConverterParameter=330}"/>
                                    </Border>
                                    <TextBlock Text="{Binding TokensText}" Style="{StaticResource T.Muted}" FontSize="10" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="◢ BY DAY" Style="{StaticResource T.Pixel.Section}" Margin="0,16,0,8"/>
                    <ItemsControl ItemsSource="{Binding ByDay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="62"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource T.Mono}" FontSize="10"
                                               Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Height="11" Background="{StaticResource B.BG.Sunken}">
                                        <Rectangle Height="11" HorizontalAlignment="Left"
                                                   Fill="{StaticResource B.RustDim}"
                                                   Width="{Binding Percent, Converter={x:Static vm:PercentToWidthConverter.Instance}, ConverterParameter=190}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding CostText}" Style="{StaticResource T.Mono}" FontSize="10"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource B.Ember}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT: sessions -->
            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Top" Padding="16,10,16,8" Background="{StaticResource B.BG.Primary}">
                    <TextBlock Text="◢ SESSIONS BY COST" Style="{StaticResource T.Pixel.Section}"/>
                </Border>

                <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding Selected}"
                         Background="{StaticResource B.BG.Sunken}" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding CostText}" FontFamily="{StaticResource Font.CRT}" FontSize="21"
                                           Foreground="{StaticResource B.Ember}" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Margin="6,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayLabel}" Style="{StaticResource T.Body}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="430"
                                                   ToolTip="{Binding SessionId}"/>
                                        <TextBlock Text="{Binding ShortId}" Style="{StaticResource T.Mono}" FontSize="10" Margin="8,2,0,0"
                                                   Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Center"/>
                                        <Border Padding="5,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Background="{StaticResource B.RustDim}"
                                                Visibility="{Binding SubagentText, Converter={x:Static vm:StringNotEmptyToVisibility.Instance}}">
                                            <TextBlock Text="{Binding SubagentText}" FontFamily="{StaticResource Font.Pixel}" FontSize="7"
                                                       Foreground="{StaticResource B.Text}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource T.Muted}" FontSize="11" Margin="0,3,0,0">
                                        <Run Text="{Binding PrimaryModel, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding TotalTokensText, Mode=OneWay}"/><Run Text=" tok  ·  out "/><Run Text="{Binding OutputText, Mode=OneWay}"/><Run Text="  ·  cache "/><Run Text="{Binding CacheReadText, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding RangeText}" Style="{StaticResource T.Muted}" FontSize="10" Margin="0,2,0,0"
                                               Foreground="{StaticResource B.TextMuted}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Content="COPY" Style="{StaticResource Btn.Pixel}" MinWidth="84"
                                            Command="{Binding DataContext.CopyBreakdownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Copy the per-model token and cost breakdown"/>
                                    <Button Content="OPEN" Style="{StaticResource Btn.Pixel}" MinWidth="84" Margin="0,5,0,0"
                                            Command="{Binding DataContext.OpenTranscriptCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Reveal the transcript in Explorer"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
