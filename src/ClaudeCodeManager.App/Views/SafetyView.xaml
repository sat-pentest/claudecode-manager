<UserControl x:Class="ClaudeCodeManager.App.Views.SafetyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ClaudeCodeManager.App.ViewModels"
             xmlns:svc="clr-namespace:ClaudeCodeManager.App.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:EngagementSafetyViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Section toggle-header template — matches WORKFLOWS INSTALLED tab pattern -->
        <Style x:Key="Section.Toggle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource B.BG.Panel}" Padding="18,10"
                                BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="Bd" Value="{StaticResource B.BG.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="{StaticResource B.BG.Primary}">
    <StackPanel>

        <!-- ═══════ STATE CARD (always visible — top priority info) ═══════ -->
        <Border Background="{StaticResource B.BG.Panel}" Padding="20,16" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- State pill (Big, prominent) -->
                <Border Grid.Column="0" Grid.RowSpan="2" Padding="18,12" VerticalAlignment="Center" MinWidth="150">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource B.TextDim}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsArmed}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource B.Success}"/>
                                    <Setter Property="Effect" Value="{StaticResource Glow.Soft}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsKillSwitchActive}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource B.Danger}"/>
                                    <Setter Property="Effect" Value="{StaticResource Glow.Soft}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding OverallState}" FontFamily="{StaticResource Font.UI}" FontWeight="Medium" FontSize="20"
                               Foreground="{StaticResource B.BG.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Middle: engagement info (Rust accent bar prefix, matches SCOPE section style) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Rectangle Width="3" Fill="{StaticResource B.Rust}" Margin="0,4,12,4"
                               VerticalAlignment="Stretch"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding EngagementId}" FontFamily="{StaticResource Font.Mono}" FontSize="17"
                                   Foreground="{StaticResource B.Ember}" Effect="{StaticResource Glow.Soft}"/>
                        <TextBlock FontSize="13" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource T.Mono}">
                                    <Setter Property="Text" Value="{Binding Target}"/>
                                    <Setter Property="Foreground" Value="{StaticResource B.TextMuted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Target}" Value="">
                                            <Setter Property="Text" Value="(target not set — 프리셋의 target 필드 비어있음)"/>
                                            <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
                                            <Setter Property="FontStyle" Value="Italic"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Right: env + enforceMode badges (hidden when value is empty) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0">
                    <Border Padding="12,6,12,7" Margin="0,0,6,0" MinWidth="88"
                            Visibility="{Binding Environment, Converter={x:Static vm:StringToVisibility.Instance}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource B.RustDim}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Environment}" Value="production">
                                        <Setter Property="Background" Value="{StaticResource B.Danger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Environment, Converter={x:Static vm:UpperCaseConverter.Instance}}"
                                   FontFamily="{StaticResource Font.UI}" FontWeight="Medium" FontSize="12" Foreground="{StaticResource B.BG.Primary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Padding="12,6,12,7" Background="{StaticResource B.BG.Sunken}" BorderBrush="{StaticResource B.RustDim}" BorderThickness="1" MinWidth="60"
                            Visibility="{Binding EnforceMode, Converter={x:Static vm:StringToVisibility.Instance}}">
                        <TextBlock Text="{Binding EnforceMode, Converter={x:Static vm:UpperCaseConverter.Instance}}"
                                   FontFamily="{StaticResource Font.UI}" FontWeight="Medium" FontSize="12" Foreground="{StaticResource B.Ember}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Row 2: status line + action feedback + coverage note -->
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="18,12,0,0">
                    <TextBlock Text="{Binding StatusText}" FontFamily="{StaticResource Font.Mono}" FontSize="13"
                               Foreground="{StaticResource B.TextMuted}"/>
                    <TextBlock Text="{Binding ActionLog}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                               Foreground="{StaticResource B.Ember}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding ActionLog, Converter={x:Static vm:StringToVisibility.Instance}}"/>
                    <!-- Coverage summary: which layer catches which caller -->
                    <Border Background="{StaticResource B.BG.Sunken}" BorderBrush="{StaticResource B.BorderSoft}" BorderThickness="1"
                            Padding="10,7" Margin="0,8,20,0">
                        <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12" TextWrapping="Wrap">
                            <Run Text="COVERAGE " FontWeight="Bold" Foreground="{StaticResource B.Ember}"/>
                            <Run Text="·" Foreground="{StaticResource B.TextDim}"/>
                            <Run Text=" L2 hook = workflow-subagent 전용 (사용자 직접 명령·Agent 도구 spawn 은 통과)" Foreground="{StaticResource B.TextMuted}"/>
                            <LineBreak/>
                            <Run Text="         " Foreground="{StaticResource B.TextDim}"/>
                            <Run Text="·" Foreground="{StaticResource B.TextDim}"/>
                            <Run Text=" L1 mitmproxy = process 전체 (armed 시 프록시 세팅된 자식 프로세스 모두 커버)" Foreground="{StaticResource B.TextMuted}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════ PRESETS ROW (always visible) ═══════ -->
        <Border Background="{StaticResource B.BG.Panel}" Padding="18,12" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Label + Active indicator -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Rectangle Width="3" Height="16" Fill="{StaticResource B.Ember}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="PRESET" Style="{StaticResource T.Pixel.Section}" FontSize="14" VerticalAlignment="Center"/>
                    <Border Padding="10,5,10,6" Margin="12,0,0,0" VerticalAlignment="Center"
                            Background="{StaticResource B.Success}"
                            Effect="{StaticResource Glow.Soft}"
                            svc:PulseBehavior.IsActive="True"
                            Visibility="{Binding HasActivePreset, Converter={x:Static vm:BoolToVisibility.Instance}}"
                            ToolTip="현재 스코프와 일치하는 프리셋">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource B.BG.Primary}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding ActivePresetName}" FontFamily="{StaticResource Font.Mono}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource B.BG.Primary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ComboBox (mid) — Stretch across available middle column, min 320 for the "name · engagementId" label -->
                <ComboBox Grid.Row="0" Grid.Column="1" MinWidth="320" MaxWidth="520" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Margin="0,0,14,0"
                          ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                          IsEditable="False"
                          ToolTip="프리셋 선택 (~/.claude/redteam-safety/presets/)">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Mono}" FontSize="13" Foreground="{StaticResource B.Ember}" FontWeight="Bold"/>
                                <TextBlock Text=" · " FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{StaticResource B.TextDim}" Margin="4,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding EngagementId}" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Right: primary action buttons -->
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="ENFORCE WITH PRESET" Style="{StaticResource Btn.Pixel.Primary}"
                            Command="{Binding ArmWithPresetCommand}" CommandParameter="{Binding SelectedPreset}"
                            Padding="14,6"
                            ToolTip="선택된 프리셋으로 ENFORCE ON (mitmproxy + env 자동). 프리셋 스코프 로드는 콤보박스 선택 시 자동 반영됨."/>
                </StackPanel>

                <!-- Row 2: secondary action buttons + folder -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="SAVE AS…" Style="{StaticResource Btn.Pixel}"
                            Command="{Binding SaveAsPresetCommand}"
                            Padding="12,4" Margin="0,0,6,0" FontSize="12"
                            ToolTip="현재 스코프를 새 프리셋으로 저장"/>
                    <Button Content="DELETE" Command="{Binding DeletePresetCommand}" CommandParameter="{Binding SelectedPreset}"
                            Padding="12,4" Margin="0,0,6,0" FontSize="11"
                            ToolTip="선택 프리셋 삭제">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Btn.Pixel}">
                                <Setter Property="Foreground" Value="{StaticResource B.Danger}"/>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="OPEN PRESETS FOLDER" Style="{StaticResource Btn.Pixel}"
                            Command="{Binding OpenPresetsFolderCommand}"
                            Padding="12,4" FontSize="12"
                            ToolTip="프리셋 폴더 열기"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════ ACTIONS TOOLBAR (always visible) ═══════ -->
        <Border Background="{StaticResource B.BG.Sunken}" Padding="18,10" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Primary arm/disarm group -->
                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Button Content="ENFORCE ON" Style="{StaticResource Btn.Pixel.Primary}" Command="{Binding ArmOnCommand}" Padding="16,6" Margin="0,0,4,0"
                            ToolTip="스코프 정책 강제 활성화 · mitmproxy 자동 실행 · HTTP_PROXY 자동 설정"/>
                    <Button Content="ENFORCE OFF" Style="{StaticResource Btn.Pixel}" Command="{Binding ArmOffCommand}" Padding="16,6"
                            ToolTip="스코프 정책 강제 해제 · mitmproxy 종료 · HTTP_PROXY 제거"/>
                </StackPanel>

                <!-- Emergency kill group -->
                <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="20,0,0,0">
                    <Button Content="STOP" Command="{Binding KillSwitchOnCommand}" Padding="16,6" Margin="0,0,4,0"
                            ToolTip="KILL-SWITCH 활성 · enforcement 상태에서 모든 도구 호출 즉시 차단">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Btn.Pixel}">
                                <Setter Property="Foreground" Value="{StaticResource B.Danger}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource B.Danger}"/>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="RESUME" Style="{StaticResource Btn.Pixel}" Command="{Binding KillSwitchOffCommand}" Padding="14,6"
                            ToolTip="KILL-SWITCH 해제"/>
                </StackPanel>

                <!-- Right: helpers -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="REFRESH" Style="{StaticResource Btn.Pixel}" Command="{Binding RefreshCommand}" Padding="12,6" Margin="0,0,4,0"/>
                    <Button Content="OPEN FOLDER" Style="{StaticResource Btn.Pixel}" Command="{Binding OpenSafetyFolderCommand}" Padding="12,6" Margin="0,0,4,0"/>
                    <Button Content="EDIT MANIFEST" Style="{StaticResource Btn.Pixel}" Command="{Binding OpenManifestCommand}" Padding="12,6"
                            ToolTip="active-engagement.json 편집 (notepad)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════ SECTION 1: L1 ENFORCEMENT (collapsible) ═══════ -->
        <Button Style="{StaticResource Section.Toggle}" Command="{Binding ToggleL1Command}"
                ToolTip="Toggle L1 ENFORCEMENT section">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="◢ L1 ENFORCEMENT" Style="{StaticResource T.Pixel.Section}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="mitmproxy · env proxy" Style="{StaticResource T.Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <!-- Inline status dots -->
                    <Ellipse Width="8" Height="8" Margin="16,0,4,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource B.TextDim}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMitmproxyRunning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource B.Success}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="proxy" FontFamily="{StaticResource Font.UI}" FontWeight="Medium" FontSize="12" Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Center"/>
                    <Ellipse Width="8" Height="8" Margin="14,0,4,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource B.TextDim}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProxyEnvSet}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource B.Success}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="env" FontFamily="{StaticResource Font.UI}" FontWeight="Medium" FontSize="12" Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" FontFamily="{StaticResource Font.Mono}" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource B.Ember}" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="»"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsL1Collapsed}" Value="True">
                                    <Setter Property="Text" Value="«"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Button>

        <Border Background="{StaticResource B.BG.Panel}" Padding="24,16" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1"
                Visibility="{Binding IsL1Collapsed, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
            <StackPanel>
                <!-- mitmproxy row -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MITM_PROXY" Style="{StaticResource T.Pixel.Section}" FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Margin="0,0,10,0"
                                 svc:PulseBehavior.IsActive="{Binding IsMitmproxyRunning}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource B.TextDim}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMitmproxyRunning}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource B.Success}"/>
                                            <Setter Property="Effect" Value="{StaticResource Glow.Soft}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="15" VerticalAlignment="Center">
                            <Run Text="{Binding IsMitmproxyRunning, Converter={x:Static vm:BoolToOnOffConverter.Instance}}" Foreground="{StaticResource B.Ember}"/>
                            <Run Text="  · port 8888" Foreground="{StaticResource B.TextMuted}" FontSize="12"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="START" Style="{StaticResource Btn.Pixel}" Command="{Binding StartMitmOnlyCommand}" Padding="12,4" Margin="0,0,4,0"
                                Visibility="{Binding IsMitmproxyRunning, Converter={x:Static vm:InverseBoolToVisibility.Instance}}"/>
                        <Button Content="STOP" Style="{StaticResource Btn.Pixel}" Command="{Binding StopMitmOnlyCommand}" Padding="12,4"
                                Visibility="{Binding IsMitmproxyRunning, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                    </StackPanel>
                </Grid>

                <!-- HTTP_PROXY row -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="HTTP_PROXY env" Style="{StaticResource T.Pixel.Section}" FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Margin="0,0,10,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource B.TextDim}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProxyEnvSet}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource B.Success}"/>
                                            <Setter Property="Effect" Value="{StaticResource Glow.Soft}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="15" VerticalAlignment="Center">
                            <Run Text="{Binding IsProxyEnvSet, Converter={x:Static vm:BoolToOnOffConverter.Instance}}" Foreground="{StaticResource B.Ember}"/>
                            <Run Text="  · http://127.0.0.1:8888 (user scope)" Foreground="{StaticResource B.TextMuted}" FontSize="12"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="SET" Style="{StaticResource Btn.Pixel}" Command="{Binding SetProxyEnvCommand}" Padding="12,4" Margin="0,0,4,0"
                                Visibility="{Binding IsProxyEnvSet, Converter={x:Static vm:InverseBoolToVisibility.Instance}}"/>
                        <Button Content="CLEAR" Style="{StaticResource Btn.Pixel}" Command="{Binding ClearProxyEnvCommand}" Padding="12,4"
                                Visibility="{Binding IsProxyEnvSet, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                    </StackPanel>
                </Grid>

                <!-- Auto-elevate toggle -->
                <Border Background="{StaticResource B.BG.Sunken}" BorderBrush="{StaticResource B.Success}" BorderThickness="1" Padding="12,8" Margin="0,6,0,6">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding AutoElevateEnabled}" VerticalAlignment="Center"/>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="AUTO-ELEVATE L1 ON ENFORCE" FontFamily="{StaticResource Font.UI}" FontWeight="Medium" FontSize="12" Foreground="{StaticResource B.Success}"/>
                            <TextBlock TextWrapping="Wrap" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{StaticResource B.TextMuted}" Margin="0,3,0,0">
                                워크플로우가 auto-arm-target.ps1로 자동 enforcement 활성화 하면 CCM이 감지하여 mitmproxy + HTTP_PROXY env도 자동 시작.
                                수동 ENFORCE ON 클릭 없이 워크플로우 실행 → L1+L2 완전 자동 활성화.
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Coverage explanation banner -->
                <Border Background="{StaticResource B.BG.Sunken}" BorderBrush="{StaticResource B.RustDim}" BorderThickness="1" Padding="14,10" Margin="0,6,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="⚠" FontSize="15" Foreground="{StaticResource B.Ember}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="주의: 도구별 mitmproxy 커버리지 다름" FontFamily="{StaticResource Font.UI}" FontWeight="Medium" FontSize="13" Foreground="{StaticResource B.Ember}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Green: covered -->
                        <StackPanel Orientation="Horizontal" Margin="24,4,0,0">
                            <TextBlock Text="✓" FontSize="13" Foreground="{StaticResource B.Success}" Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12" TextWrapping="Wrap">
                                <Run Text="CLI 도구 커버 (HTTP_PROXY env 통해 mitmproxy 경유):" Foreground="{StaticResource B.Text}"/>
                                <LineBreak/>
                                <Run Text="   curl · PowerShell (Invoke-WebRequest/IRM) · ffuf · nuclei · sqlmap · Python requests · Node.js fetch" Foreground="{StaticResource B.TextMuted}"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Red: bypasses -->
                        <StackPanel Orientation="Horizontal" Margin="24,8,0,0">
                            <TextBlock Text="✗" FontSize="13" Foreground="{StaticResource B.Danger}" Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12" TextWrapping="Wrap">
                                <Run Text="mitmproxy 우회 (자체 네트워크 스택 사용 · HTTP_PROXY env 무시):" Foreground="{StaticResource B.Text}"/>
                                <LineBreak/>
                                <Run Text="   Burp MCP · Playwright MCP · 브라우저 · subfinder · naabu (raw socket)" Foreground="{StaticResource B.TextMuted}"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Action items -->
                        <Border Background="{StaticResource B.BG.Panel}" BorderBrush="{StaticResource B.BorderSoft}" BorderThickness="1" Padding="12,8" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="우회 도구를 mitmproxy에 태우려면:" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{StaticResource B.Text}" Margin="0,0,0,4"/>
                                <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12" TextWrapping="Wrap">
                                    <Run Text="  • Burp:" Foreground="{StaticResource B.TextMuted}"/>
                                    <Run Text=" Settings → Network → Upstream Proxy → 127.0.0.1:8888" Foreground="{StaticResource B.Ember}"/>
                                    <LineBreak/>
                                    <Run Text="  • Playwright:" Foreground="{StaticResource B.TextMuted}"/>
                                    <Run Text=" launchOptions.proxy = { server: 'http://127.0.0.1:8888' }" Foreground="{StaticResource B.Ember}"/>
                                    <LineBreak/>
                                    <Run Text="  • 브라우저:" Foreground="{StaticResource B.TextMuted}"/>
                                    <Run Text=" 시스템 프록시 or 확장으로 지정" Foreground="{StaticResource B.Ember}"/>
                                </TextBlock>
                                <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{StaticResource B.TextDim}" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="(L2 훅은 workflow-subagent 컨텍스트만 감시함. 사용자 직접 curl·PowerShell 명령은 L2 통과 · L1 프록시가 활성 상태면 armed 상태에서 실 트래픽 단계에서 여전히 잡힘)"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══════ SECTION 2: SCOPE EDITOR (collapsible) ═══════ -->
        <Button Style="{StaticResource Section.Toggle}" Command="{Binding ToggleScopeCommand}"
                ToolTip="Toggle SCOPE EDITOR section">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="◢ ENGAGEMENT SCOPE" Style="{StaticResource T.Pixel.Section}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource T.Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Run Text="include "/><Run Text="{Binding ScopeInclude.Count, Mode=OneWay}" Foreground="{StaticResource B.Success}"/>
                        <Run Text=" · exclude "/><Run Text="{Binding ScopeExclude.Count, Mode=OneWay}" Foreground="{StaticResource B.Danger}"/>
                        <Run Text=" · infra "/><Run Text="{Binding InfraAllow.Count, Mode=OneWay}" Foreground="{StaticResource B.Ember}"/>
                    </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="1" FontFamily="{StaticResource Font.Mono}" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource B.Ember}" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="»"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScopeCollapsed}" Value="True">
                                    <Setter Property="Text" Value="«"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Button>

        <Border Background="{StaticResource B.BG.Panel}" Padding="24,16" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1"
                Visibility="{Binding IsScopeCollapsed, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
            <StackPanel>

                <!-- INCLUDE group -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="3" Height="14" Fill="{StaticResource B.Success}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="INCLUDE" Style="{StaticResource T.Pixel.Section}" FontSize="12" Foreground="{StaticResource B.Success}" VerticalAlignment="Center"/>
                        <TextBlock Text="허용 apex 도메인 · 서브도메인은 suffix 매치로 자동 포함" Style="{StaticResource T.Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding ScopeInclude.Count}" FontFamily="{StaticResource Font.UI}" FontWeight="Medium" FontSize="13" Foreground="{StaticResource B.Success}" VerticalAlignment="Center"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding ScopeInclude}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource B.Success}" BorderThickness="1" Background="{StaticResource B.BG.Sunken}" Padding="9,3,4,4" Margin="0,3,6,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Mono}" FontSize="13" Foreground="{StaticResource B.Text}" VerticalAlignment="Center"/>
                                    <Button Content="×" Style="{StaticResource Btn.ChipDelete}" Margin="5,0,0,0"
                                            Command="{Binding DataContext.RemoveScopeIncludeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,20">
                    <TextBox Width="280" Padding="6,4" Text="{Binding NewScopeInclude, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="+ ADD" Style="{StaticResource Btn.Pixel}" Command="{Binding AddScopeIncludeCommand}" Padding="14,4" Margin="6,0,0,0"/>
                </StackPanel>

                <!-- EXCLUDE group -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="3" Height="14" Fill="{StaticResource B.Danger}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="EXCLUDE" Style="{StaticResource T.Pixel.Section}" FontSize="12" Foreground="{StaticResource B.Danger}" VerticalAlignment="Center"/>
                        <TextBlock Text="명시 차단 도메인 · scope 내라도 차단 우선" Style="{StaticResource T.Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding ScopeExclude.Count}" FontFamily="{StaticResource Font.UI}" FontWeight="Medium" FontSize="13" Foreground="{StaticResource B.Danger}" VerticalAlignment="Center"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding ScopeExclude}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource B.Danger}" BorderThickness="1" Background="{StaticResource B.BG.Sunken}" Padding="9,3,4,4" Margin="0,3,6,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Mono}" FontSize="13" Foreground="{StaticResource B.Text}" VerticalAlignment="Center"/>
                                    <Button Content="×" Style="{StaticResource Btn.ChipDelete}" Margin="5,0,0,0"
                                            Command="{Binding DataContext.RemoveScopeExcludeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,20">
                    <TextBox Width="280" Padding="6,4" Text="{Binding NewScopeExclude, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="+ ADD" Style="{StaticResource Btn.Pixel}" Command="{Binding AddScopeExcludeCommand}" Padding="14,4" Margin="6,0,0,0"/>
                </StackPanel>

                <!-- INFRA ALLOW group -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="3" Height="14" Fill="{StaticResource B.Ember}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="INFRA ALLOW" Style="{StaticResource T.Pixel.Section}" FontSize="12" Foreground="{StaticResource B.Ember}" VerticalAlignment="Center"/>
                        <TextBlock Text="정찰 인프라 · crt.sh · Collaborator · GitHub" Style="{StaticResource T.Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding InfraAllow.Count}" FontFamily="{StaticResource Font.UI}" FontWeight="Medium" FontSize="13" Foreground="{StaticResource B.Ember}" VerticalAlignment="Center"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding InfraAllow}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource B.RustDim}" BorderThickness="1" Background="{StaticResource B.BG.Sunken}" Padding="9,3,4,4" Margin="0,3,6,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Mono}" FontSize="13" Foreground="{StaticResource B.Ember}" VerticalAlignment="Center"/>
                                    <Button Content="×" Style="{StaticResource Btn.ChipDelete}" Margin="5,0,0,0"
                                            Command="{Binding DataContext.RemoveInfraAllowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,20">
                    <TextBox Width="280" Padding="6,4" Text="{Binding NewInfraAllow, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="+ ADD" Style="{StaticResource Btn.Pixel}" Command="{Binding AddInfraAllowCommand}" Padding="14,4" Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Meta fields (rate/concurrency/cwdRoot) -->
                <Border Background="{StaticResource B.BG.Sunken}" BorderBrush="{StaticResource B.BorderSoft}" BorderThickness="1" Padding="14,10" Margin="0,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="RATE/host/s" Style="{StaticResource T.Pixel.Section}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding PerHostRps}" FontFamily="{StaticResource Font.Mono}" FontSize="15" Foreground="{StaticResource B.Ember}"/>
                        <TextBlock Grid.Column="2" Text="CONCURRENCY" Style="{StaticResource T.Pixel.Section}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding GlobalConcurrency}" FontFamily="{StaticResource Font.Mono}" FontSize="15" Foreground="{StaticResource B.Ember}"/>

                        <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Text="CWD ROOT" Style="{StaticResource T.Pixel.Section}" FontSize="12" Margin="0,10,0,4"/>
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Text="{Binding CwdRoot}" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{StaticResource B.TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,26,0,0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══════ SECTION 3: RECENT HOOK EVENTS (collapsible) ═══════ -->
        <Button Style="{StaticResource Section.Toggle}" Command="{Binding ToggleRecentCommand}"
                ToolTip="Toggle RECENT HOOK EVENTS section">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="◢ RECENT HOOK EVENTS" Style="{StaticResource T.Pixel.Section}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource T.Muted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Run Text="{Binding RecentBlocks.Count, Mode=OneWay}" Foreground="{StaticResource B.Ember}"/>
                        <Run Text=" events · 2s refresh"/>
                    </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="1" FontFamily="{StaticResource Font.Mono}" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource B.Ember}" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="»"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRecentCollapsed}" Value="True">
                                    <Setter Property="Text" Value="«"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Button>

        <Border Background="{StaticResource B.BG.Panel}" Padding="18,12" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1"
                Visibility="{Binding IsRecentCollapsed, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                    <Button Content="OPEN LOG" Style="{StaticResource Btn.Pixel}" Command="{Binding OpenAuditLogCommand}" Padding="10,4" Margin="0,0,6,0"
                            ToolTip="hook-audit.log 파일을 Explorer에서 열기"/>
                    <Button Content="CLEAR VIEW" Style="{StaticResource Btn.Pixel}" Command="{Binding ClearRecentBlocksCommand}" Padding="10,4" Margin="0,0,6,0"
                            ToolTip="이 화면 목록만 지우기 (파일은 유지)"/>
                    <Button Content="ARCHIVE LOG" Command="{Binding ArchiveAuditLogCommand}" Padding="10,4"
                            ToolTip="로그 파일을 archive/ 폴더로 이동 후 빈 로그로 새로 시작 (이전 엔게이지먼트 이벤트 제거)">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Btn.Pixel}">
                                <Setter Property="Foreground" Value="{StaticResource B.Danger}"/>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding RecentBlocks}" MaxHeight="360">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource B.BorderSoft}" BorderThickness="0,0,0,1" Padding="6,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Timestamp}" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{StaticResource B.TextDim}" Margin="0,0,12,0" VerticalAlignment="Center" MinWidth="90"/>
                                    <Border Grid.Column="1" Padding="7,2,7,3" Margin="0,0,10,0" VerticalAlignment="Center" MinWidth="52">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource B.TextDim}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDeny}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource B.Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Decision}" FontFamily="{StaticResource Font.UI}" FontWeight="Medium" FontSize="12" Foreground="{StaticResource B.BG.Primary}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Reason}" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{StaticResource B.Ember}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Command}" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{StaticResource B.TextMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel HorizontalAlignment="Center" Margin="0,14,0,6"
                            Visibility="{Binding RecentBlocks.Count, Converter={x:Static vm:InverseIntPositiveToVisibility.Instance}, FallbackValue=Collapsed}">
                    <TextBlock Text="( 아직 기록된 hook 이벤트 없음 )" Style="{StaticResource T.Muted}" FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Text="hook은 ENFORCED 상태에서만 동작" Style="{StaticResource T.Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

    </StackPanel>
    </ScrollViewer>
</UserControl>
