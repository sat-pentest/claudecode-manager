<Window x:Class="ClaudeCodeManager.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Confirm"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource B.BG.Panel}"
        BorderBrush="{StaticResource B.Rust}"
        BorderThickness="1"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource Font.UI}" FontSize="13">

    <DockPanel>
        <!-- Header (draggable) -->
        <Border x:Name="Header" DockPanel.Dock="Top" Background="{StaticResource B.BG.Sunken}"
                Padding="18,10,10,10"
                BorderBrush="{StaticResource B.Border}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnHeaderMouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="◆" Foreground="{StaticResource B.Rust}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" x:Name="HeaderText"
                           FontFamily="{StaticResource Font.UI}" FontWeight="Medium" FontSize="13"
                           Foreground="{StaticResource B.Ember}"
                           Effect="{StaticResource Glow.Soft}"
                           VerticalAlignment="Center"
                           TextOptions.TextFormattingMode="Ideal"/>
                <Button Grid.Column="2" Content="✕" Click="OnCancel"
                        Background="Transparent" Foreground="{StaticResource B.TextMuted}"
                        BorderThickness="0" FontFamily="{StaticResource Font.Mono}" FontSize="15"
                        Width="36" Height="26" Cursor="Hand"
                        VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" TargetName="Bd" Value="{StaticResource B.Danger}"/>
                                    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource B.BG.Sunken}"
                Padding="18,12"
                BorderBrush="{StaticResource B.Border}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="확인"
                        IsDefault="True" Click="OnOk"
                        Style="{StaticResource Btn.Pixel.Primary}"
                        MinWidth="90" Margin="0,0,8,0"/>
                <Button x:Name="CancelButton" Content="취소"
                        IsCancel="True" Click="OnCancel"
                        Style="{StaticResource Btn.Pixel}"
                        MinWidth="90"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Border Padding="22,20">
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       FontFamily="{StaticResource Font.UI}"
                       FontSize="14"
                       Foreground="{StaticResource B.Text}"
                       LineHeight="20"/>
        </Border>
    </DockPanel>
</Window>
