<UserControl x:Class="ClaudeCodeManager.App.Views.SkillsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ClaudeCodeManager.App.ViewModels"
             xmlns:svc="clr-namespace:ClaudeCodeManager.App.Services"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:helper="clr-namespace:ClaudeCodeManager.App.Services"
             xmlns:local="clr-namespace:ClaudeCodeManager.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:SkillsViewModel}"
             mc:Ignorable="d">

    <UserControl.InputBindings>
        <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find"/>
    </UserControl.InputBindings>

    <UserControl.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindExecuted"/>
    </UserControl.CommandBindings>

    <Grid Background="{StaticResource B.BG.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR (matches MemoryView header) -->
        <Border Background="{StaticResource B.BG.Panel}" Padding="16,10" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource Icon.Module}" Data="{Binding Glyph, Converter={x:Static vm:StringToGeometry.Instance}}"/>
                <TextBlock Text="SKILLS" Style="{StaticResource T.Pixel.Section}" VerticalAlignment="Center"/>
                <Button Content="REFRESH" Style="{StaticResource Btn.Pixel}" Command="{Binding RefreshCommand}" Margin="16,0,0,0"/>
                <Button Style="{StaticResource Btn.Pixel}" Command="{Binding ToggleSecurityPanelCommand}" Margin="8,0,0,0"
                        ToolTip="Static rule scan over skill and agent definitions, with a review baseline">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SECURITY" VerticalAlignment="Center"/>
                        <!--
                            Press Start 2P draws taller than the box a 7px size reserves, so a one
                            pixel gutter clipped the digit's foot. Eight is on the font's own grid
                            and the gutter is wide enough to hold the glyph whole.
                        -->
                        <Border Padding="6,3" Margin="8,0,0,0" VerticalAlignment="Center"
                                Background="{StaticResource B.Danger}"
                                Visibility="{Binding HasSecurityAttention, Converter={x:Static vm:BoolToVisibility.Instance}}">
                            <TextBlock Text="{Binding NeedsAttentionCount}" FontFamily="{StaticResource Font.Pixel}" FontSize="8"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource B.Text}"/>
                        </Border>
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding Status}" Style="{StaticResource T.Muted}" FontSize="12" Margin="20,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="260"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: grouped skill list -->
            <DockPanel Background="{StaticResource B.BG.Panel}">
                <DockPanel.Resources>
                    <!-- One skill row, shared by every group's inner list. -->
                    <DataTemplate x:Key="SkillRowTemplate">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="●" Width="14" VerticalAlignment="Center"
                                           svc:PulseBehavior.IsActive="{Binding Disabled, Converter={x:Static vm:InverseBool.Instance}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource B.Success}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Disabled}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Mono}" FontSize="14" VerticalAlignment="Center"/>
                                <Border Padding="5,4,5,4" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Background="{StaticResource B.RustDim}"
                                        Visibility="{Binding Disabled, Converter={x:Static vm:BoolToVisibility.Instance}}">
                                    <TextBlock Text="OFF" FontFamily="{StaticResource Font.Pixel}" FontSize="7" Foreground="{StaticResource B.Text}" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            <TextBlock helper:MarkdownInlineHelper.Text="{Binding Description}" Style="{StaticResource T.Muted}" FontSize="12" Margin="14,3,4,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </DockPanel.Resources>

                <!-- Header: title + GROUP BY axis selector -->
                <Grid DockPanel.Dock="Top" Margin="16,14,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="◢ INSTALLED" Style="{StaticResource T.Pixel.Section}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="GROUP" Style="{StaticResource T.Pixel.Section}" FontSize="6" Foreground="{StaticResource B.TextDim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding GroupAxes}"
                                  SelectedItem="{Binding GroupAxis, Mode=TwoWay}"
                                  Width="110" FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                  ToolTip="좌측 목록 그룹 기준 · CATEGORY(용도) / STATUS(활성) / NONE(평면)"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8,0,8,8">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,2">
                                    <!-- Section header — a filled bar, click folds the group. -->
                                    <ToggleButton Style="{StaticResource Btn.SkillGroup}"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                  AutomationProperties.Name="{Binding Title}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Chevron: down when open, right when shut. -->
                                            <Path x:Name="Chevron" Width="7" Height="7" Margin="0,0,9,0"
                                                  VerticalAlignment="Center" Data="M0,0 L7,3.5 L0,7 Z"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0"/>
                                                </Path.RenderTransform>
                                            </Path>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource Font.Pixel}" FontSize="9"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                            <!--
                                                Count pill. Press Start 2P draws taller than a 7px
                                                box reserves, so the digit's top was clipping; 8px is
                                                on the font's grid and the gutter holds it whole.
                                            -->
                                            <Border Grid.Column="2" Background="{StaticResource B.RustDim}" Padding="7,3,7,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Count}" FontFamily="{StaticResource Font.Pixel}" FontSize="8"
                                                           Foreground="{StaticResource B.Text}" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </ToggleButton>

                                    <!-- Body — folds via the shared height animation. Inner list binds
                                         its selection to the module's one Selected, so selecting a skill
                                         in any group clears the others without coordination. Inner
                                         scrolling is off: the outer ScrollViewer is the only scroller,
                                         and the list sizes to its content so the fold measures right. -->
                                    <Border ClipToBounds="True" local:NavGroupAnimation.IsOpen="{Binding IsExpanded}">
                                        <ListBox ItemsSource="{Binding Skills}"
                                                 SelectedItem="{Binding DataContext.Selected, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ItemTemplate="{StaticResource SkillRowTemplate}"/>
                                    </Border>
                                </StackPanel>

                                <DataTemplate.Triggers>
                                    <!-- Chevron reflects fold state, correct on first load: entering
                                         the expanded state rotates to 90°, and a group that starts
                                         collapsed keeps the default 0° (pointing right). -->
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Chevron"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     To="90" Duration="0:0:0.16"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Chevron"
                                                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     To="0" Duration="0:0:0.16"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="1" Style="{StaticResource Splitter.Vertical}"/>

            <!-- RIGHT: DETAIL -->
            <Grid Grid.Column="2" Background="{StaticResource B.BG.Sunken}">

                <!-- Empty state (뒤에 겹쳐 표시, Selected null 일 때만 보임) -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="▤" FontFamily="{StaticResource Font.CRT}" FontSize="72" Foreground="{StaticResource B.RustDim}" HorizontalAlignment="Center" Opacity="0.5"/>
                    <TextBlock Text="SELECT A SKILL" Style="{StaticResource T.Pixel.Section}" FontSize="10" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="왼쪽 리스트에서 스킬을 선택하세요" Style="{StaticResource T.Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Detail content -->
                <DockPanel Background="{StaticResource B.BG.Sunken}" Visibility="{Binding Selected, Converter={x:Static vm:NullToVisibility.Instance}}">

                    <!-- Toolbar -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource B.BG.Panel}" Padding="14,8" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="TOGGLE" Style="{StaticResource Btn.Pixel.Primary}" Command="{Binding ToggleCommand}" CommandParameter="{Binding Selected}" Margin="0,0,6,0"/>
                            <Button Content="OPEN FOLDER" Style="{StaticResource Btn.Pixel}" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding Selected}" Margin="0,0,6,0"/>
                            <Button Content="DELETE" Command="{Binding DeleteCommand}" CommandParameter="{Binding Selected}"
                                    ToolTip="스킬 폴더 전체 삭제 (SKILL.md + 번들 자료 · 스냅샷 자동 생성)">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Btn.Pixel}">
                                        <Setter Property="Foreground" Value="{StaticResource B.Danger}"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Text="{Binding Selected.SkillFilePath}" Style="{StaticResource T.Mono}" FontSize="12" Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- DETAIL toggle header -->
                    <Button DockPanel.Dock="Top" Command="{Binding ToggleDetailCommand}"
                            HorizontalContentAlignment="Stretch" Cursor="Hand" Padding="0"
                            ToolTip="Toggle DETAIL section">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{StaticResource B.BG.Panel}" Padding="20,10"
                                        BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" TargetName="Bd" Value="{StaticResource B.BG.Hover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="◢ DETAIL" Style="{StaticResource T.Pixel.Section}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" FontFamily="{StaticResource Font.Mono}" FontSize="14"
                                       Foreground="{StaticResource B.Ember}" VerticalAlignment="Center" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="»"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDetailCollapsed}" Value="True">
                                                <Setter Property="Text" Value="«"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>

                    <!-- DETAIL content: Header card + Meta card (collapsible together) -->
                    <StackPanel DockPanel.Dock="Top"
                                Visibility="{Binding IsDetailCollapsed, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
                    <!-- Header card: 이름 + 상태 뱃지 + description -->
                    <Border Padding="20,16" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Background="{StaticResource B.BG.Panel}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◆" FontSize="14" Foreground="{StaticResource B.Rust}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Selected.Name}" FontFamily="{StaticResource Font.CRT}" FontSize="28" Foreground="{StaticResource B.Ember}" Effect="{StaticResource Glow.Soft}" VerticalAlignment="Center"/>
                                <Border Padding="8,5,8,5" Margin="14,2,0,0" VerticalAlignment="Center"
                                        svc:PulseBehavior.IsActive="{Binding Selected.Disabled, Converter={x:Static vm:InverseBool.Instance}, FallbackValue=False}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource B.Success}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Selected.Disabled}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource B.Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontFamily="{StaticResource Font.Pixel}" FontSize="8" Foreground="{StaticResource B.BG.Primary}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="ENABLED"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Selected.Disabled}" Value="True">
                                                        <Setter Property="Text" Value="DISABLED"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                            <TextBlock helper:MarkdownInlineHelper.Text="{Binding Selected.Description}" Style="{StaticResource T.Body}" FontSize="13" TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,0" Foreground="{StaticResource B.Text}"/>
                        </StackPanel>
                    </Border>

                    <!-- Meta card: model, tools, folder -->
                    <Border Padding="20,14" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Background="{StaticResource B.BG.Panel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="MODEL" Style="{StaticResource T.Pixel.Section}" FontSize="8" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding ModelOptions}"
                                          SelectedItem="{Binding ModelChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Width="180"
                                          FontFamily="{StaticResource Font.Mono}" FontSize="13"
                                          ToolTip="Model selection. Change persists to SKILL.md immediately (snapshot created). Custom IDs supported."/>
                                <TextBlock Text="CATEGORY" Style="{StaticResource T.Pixel.Section}" FontSize="8" VerticalAlignment="Center" Margin="18,0,8,0"/>
                                <!--
                                    Group override. "(auto)" clears the frontmatter field and lets the
                                    heuristic decide; anything else pins the skill to that group and
                                    writes category: to SKILL.md.
                                -->
                                <ComboBox ItemsSource="{Binding CategoryOptions}"
                                          SelectedItem="{Binding CategoryChoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Width="130"
                                          FontFamily="{StaticResource Font.Mono}" FontSize="13"
                                          ToolTip="그룹 카테고리. (auto)=휴리스틱 자동 · 지정 시 SKILL.md 에 category 로 저장"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="TOOLS" Style="{StaticResource T.Pixel.Section}" FontSize="8" VerticalAlignment="Top" Margin="0,10,0,0"/>
                            <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Selected.Tools}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource B.RustDim}" BorderThickness="1"
                                                Background="{StaticResource B.BG.Sunken}"
                                                Padding="8,2,8,3" Margin="0,2,5,2">
                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource B.Ember}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Grid.Row="2" Text="TRIGGERS" Style="{StaticResource T.Pixel.Section}" FontSize="8" VerticalAlignment="Top" Margin="0,10,0,0"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Vertical" Margin="0,8,0,0">
                                <ItemsControl ItemsSource="{Binding Selected.Triggers}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource B.Ember}" BorderThickness="1"
                                                    Background="{StaticResource B.BG.Sunken}"
                                                    Padding="8,2,4,3" Margin="0,2,5,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{StaticResource B.Text}" VerticalAlignment="Center"/>
                                                    <Button Content="×" Style="{StaticResource Btn.ChipDelete}" Margin="4,0,0,0"
                                                            ToolTip="트리거 삭제"
                                                            Command="{Binding DataContext.RemoveTriggerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="+ ADD TRIGGER" Style="{StaticResource Btn.Pixel}" Padding="10,3,10,4" Margin="0,4,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding AddTriggerCommand}" CommandParameter="{Binding Selected}"
                                        ToolTip="새 트리거 문구 추가"/>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Text="FOLDER" Style="{StaticResource T.Pixel.Section}" FontSize="8" VerticalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selected.FolderPath}" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{StaticResource B.TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,10,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    </StackPanel>

                    <!-- Body header: clickable toggle + PREVIEW/RAW button -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource B.BG.Panel}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Toggle area -->
                            <Button Command="{Binding ToggleBodyCommand}"
                                    HorizontalContentAlignment="Stretch" Cursor="Hand" Padding="0"
                                    ToolTip="Toggle SKILL.MD section">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent" Padding="20,8">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" TargetName="Bd" Value="{StaticResource B.BG.Hover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="◢ SKILL.MD" Style="{StaticResource T.Pixel.Section}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" FontFamily="{StaticResource Font.Mono}" FontSize="14"
                                               Foreground="{StaticResource B.Ember}" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="»"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBodyCollapsed}" Value="True">
                                                        <Setter Property="Text" Value="«"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Button>
                            <!-- PREVIEW/RAW button (only when body expanded) -->
                            <Button Grid.Column="1" Command="{Binding TogglePreviewCommand}"
                                    Margin="0,6,10,6" VerticalAlignment="Center"
                                    Visibility="{Binding IsBodyCollapsed, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Btn.Pixel}">
                                        <Setter Property="Content" Value="PREVIEW"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPreviewMode}" Value="True">
                                                <Setter Property="Content" Value="RAW"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Body: SKILL.md content with edit/preview overlay -->
                    <Border Background="{StaticResource B.BG.Sunken}" Padding="6,4,0,0"
                            Visibility="{Binding IsBodyCollapsed, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
                        <Grid>
                            <avalon:TextEditor
                                IsReadOnly="True"
                                Background="{StaticResource B.BG.Sunken}"
                                Foreground="{StaticResource B.Text}"
                                FontFamily="{StaticResource Font.Mono}"
                                FontSize="14"
                                WordWrap="True"
                                ShowLineNumbers="False"
                                SyntaxHighlighting="MarkdownRust"
                                helper:AvalonEditHelper.BindableText="{Binding Selected.Body, Mode=OneWay}"
                                Visibility="{Binding IsPreviewMode, Converter={x:Static vm:InverseBoolToVisibility.Instance}}"/>
                            <FlowDocumentScrollViewer x:Name="SkillPreview"
                                                      Background="{StaticResource B.BG.Sunken}"
                                                      Foreground="{StaticResource B.Text}"
                                                      Visibility="{Binding IsPreviewMode, Converter={x:Static vm:BoolToVisibility.Instance}}"
                                                      IsToolBarVisible="False">
                                <FlowDocumentScrollViewer.CommandBindings>
                                    <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindExecuted"/>
                                </FlowDocumentScrollViewer.CommandBindings>
                            </FlowDocumentScrollViewer>
                            <local:FindOverlay x:Name="Find" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,10,20,0"/>
                        </Grid>
                    </Border>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             SECURITY overlay — 12 static rules + review baseline.
             Overlays Row 1, so the existing two-pane layout is untouched.
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{StaticResource B.BG.Primary}"
                Visibility="{Binding IsSecurityPanelOpen, Converter={x:Static vm:BoolToVisibility.Instance}}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{StaticResource B.BG.Panel}" Padding="16,10"
                        BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="◢ DEFINITION SECURITY" Style="{StaticResource T.Pixel.Section}" VerticalAlignment="Center"/>
                        <Button Content="RESCAN" Style="{StaticResource Btn.Pixel}" Command="{Binding ScanSecurityCommand}" Margin="16,0,0,0"/>
                        <Button Content="BASELINE ALL" Style="{StaticResource Btn.Pixel}" Command="{Binding MarkAllReviewedCommand}" Margin="8,0,0,0"
                                ToolTip="Sign off every definition at its current content"/>
                        <Button Content="CLOSE" Style="{StaticResource Btn.Pixel}" Command="{Binding ToggleSecurityPanelCommand}" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding SecurityStatus}" Style="{StaticResource T.Muted}" FontSize="12" Margin="20,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Bottom" Margin="16,8,16,12" TextWrapping="Wrap" FontSize="11"
                           Style="{StaticResource T.Muted}" Foreground="{StaticResource B.TextMuted}"
                           Text="Rules describe capability, not intent — a pentest skill legitimately mentions sudo, piped installers and metadata endpoints. Sign a definition off once and it stays settled until its content changes, so what remains on this list is what is genuinely new or altered."/>

                <ListBox ItemsSource="{Binding SecurityResults}" SelectedItem="{Binding SelectedSecurity}"
                         Background="{StaticResource B.BG.Sunken}" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding StateText}" FontFamily="{StaticResource Font.Pixel}" FontSize="8"
                                           VerticalAlignment="Top" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource B.Success}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StateText}" Value="NEW">
                                                    <Setter Property="Foreground" Value="{StaticResource B.Warn}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StateText}" Value="CHANGED">
                                                    <Setter Property="Foreground" Value="{StaticResource B.Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.Body}" FontSize="14"/>
                                        <TextBlock Text="{Binding ShortHash}" Style="{StaticResource T.Mono}" FontSize="10" Margin="10,2,0,0"
                                                   Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource T.Muted}" FontSize="11" Margin="0,3,0,0"/>

                                    <ItemsControl ItemsSource="{Binding Findings}" Margin="0,5,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,4" Padding="8,5" Background="{StaticResource B.BG.Panel}"
                                                        BorderBrush="{StaticResource B.BorderSoft}" BorderThickness="1">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding SeverityText}" FontFamily="{StaticResource Font.Pixel}" FontSize="7"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SeverityText}" Value="CRITICAL">
                                                                                <Setter Property="Foreground" Value="{StaticResource B.Danger}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding SeverityText}" Value="WARNING">
                                                                                <Setter Property="Foreground" Value="{StaticResource B.Warn}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Rule}" Style="{StaticResource T.Mono}" FontSize="11" Margin="10,0,0,0"/>
                                                            <TextBlock Text="{Binding LocationText}" Style="{StaticResource T.Muted}" FontSize="10" Margin="10,1,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource T.Muted}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Snippet}" Style="{StaticResource T.Mono}" FontSize="10" Margin="0,3,0,0"
                                                                   Foreground="{StaticResource B.TextDim}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                    <Button Content="SIGN OFF" Style="{StaticResource Btn.Pixel}" MinWidth="98"
                                            Command="{Binding DataContext.MarkReviewedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding NeedsAttention, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                                    <Button Content="RE-OPEN" Style="{StaticResource Btn.Pixel}" MinWidth="98"
                                            Command="{Binding DataContext.UnreviewSkillCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding NeedsAttention, Converter={x:Static vm:InverseBoolToVisibility.Instance}}"/>
                                    <Button Content="OPEN" Style="{StaticResource Btn.Pixel}" MinWidth="98" Margin="0,5,0,0"
                                            Command="{Binding DataContext.OpenSecurityTargetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

    </Grid>
</UserControl>
