<Window x:Class="ClaudeCodeManager.App.Views.JsonViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CCM · RESULT JSON"
        Height="820" Width="1100" MinHeight="360" MinWidth="620"
        Background="{StaticResource B.BG.Primary}"
        Foreground="{StaticResource B.Text}"
        Icon="../Assets/icon.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        BorderBrush="{StaticResource B.Border}"
        BorderThickness="1"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <Border Grid.Row="0" Background="{StaticResource B.BG.Panel}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="../Assets/icon.ico" Width="22" Height="22" Margin="0,0,10,0"/>
                    <TextBlock Text="CCM" Style="{StaticResource T.Pixel.Section}" FontSize="11" Foreground="{StaticResource B.Rust}" VerticalAlignment="Center"/>
                    <TextBlock Text="  ▌  RESULT JSON" Style="{StaticResource T.Pixel.Section}" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>

                <!-- Which result this JSON belongs to -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="HeadlineText" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                               Foreground="{StaticResource B.Ember}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                    <TextBlock x:Name="AgentText" Style="{StaticResource T.Muted}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Caption}" Content="—" Click="Caption_Minimize" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource Btn.Caption}" Content="▢" Click="Caption_MaxRestore" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource Btn.Caption.Close}" Content="✕" Click="Caption_Close" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TOOLBAR -->
        <Border Grid.Row="1" Background="{StaticResource B.BG.Panel}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="14,9">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ZOOM" Style="{StaticResource T.Pixel.Section}" FontSize="8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Style="{StaticResource Btn.Pixel}" Content="−" Padding="14,7" Click="OnZoomOut" ToolTip="축소 (Ctrl+− · Ctrl+휠)"/>
                <Border Background="{StaticResource B.BG.Sunken}" BorderBrush="{StaticResource B.BorderSoft}" BorderThickness="1"
                        Padding="12,7" Margin="6,0" MinWidth="66">
                    <TextBlock x:Name="ZoomText" Text="14 pt" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                               Foreground="{StaticResource B.Ember}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Button Style="{StaticResource Btn.Pixel}" Content="+" Padding="14,7" Click="OnZoomIn" ToolTip="확대 (Ctrl++ · Ctrl+휠)"/>
                <Button Style="{StaticResource Btn.Pixel}" Content="RESET" Margin="6,0,0,0" Click="OnZoomReset" ToolTip="기본 크기로 (Ctrl+0)"/>

                <Border Width="1" Background="{StaticResource B.Border}" Margin="16,2"/>

                <ToggleButton x:Name="WrapToggle" Style="{StaticResource Btn.PixelToggle}" Content="WRAP"
                              Click="OnWrapToggled" ToolTip="자동 줄바꿈 (Ctrl+W)"/>

                <Border Width="1" Background="{StaticResource B.Border}" Margin="16,2"/>

                <Button Style="{StaticResource Btn.Pixel}" Content="COPY" Click="OnCopy" ToolTip="전체 JSON 클립보드 복사"/>
            </StackPanel>
        </Border>

        <!-- BODY -->
        <Border Grid.Row="2" Background="{StaticResource B.BG.Sunken}" Margin="14,12,14,0"
                BorderBrush="{StaticResource B.BorderSoft}" BorderThickness="1">
            <!-- RichTextBox rather than TextBox: per-token colour needs inline runs, and unlike a
                 TextBlock this still allows selecting and copying a single value. -->
            <RichTextBox x:Name="JsonBox" IsReadOnly="True" IsDocumentEnabled="True"
                         Background="Transparent" Foreground="{StaticResource B.Text}"
                         BorderThickness="0" Padding="14,12"
                         FontFamily="{StaticResource Font.Mono}" FontSize="14"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <!-- STATUS -->
        <Border Grid.Row="3" Background="{StaticResource B.BG.Panel}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,1,0,0" Padding="14,7">
            <TextBlock x:Name="StatusText" Style="{StaticResource T.Muted}" FontSize="11"/>
        </Border>
    </Grid>
</Window>
