<UserControl x:Class="ClaudeCodeManager.App.Views.McpStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ClaudeCodeManager.App.ViewModels"
             xmlns:svc="clr-namespace:ClaudeCodeManager.App.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:McpStatusViewModel}"
             mc:Ignorable="d">

    <Grid Background="{StaticResource B.BG.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER: stats + toolbar -->
        <Border Grid.Row="0" Background="{StaticResource B.BG.Panel}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="◇ MCP CONNECTIONS" Style="{StaticResource T.Pixel.Section}" FontSize="13"/>
                        <TextBlock Text="  ▌  Model Context Protocol servers" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource Btn.Pixel}" Content="OPEN .claude.json" Command="{Binding OpenClaudeJsonCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource Btn.Pixel}" Content="EDIT SETTINGS" Command="{Binding OpenSettingsInModuleCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource Btn.Pixel}" Content="REFRESH" Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                </Grid>

                <UniformGrid Columns="4" Rows="1">
                    <Border Style="{StaticResource Panel.Rust}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="TOTAL" Style="{StaticResource T.Pixel.Section}" FontSize="9"/>
                            <TextBlock Text="{Binding TotalCount}" Style="{StaticResource T.CRT.Stat}" Margin="0,6,0,0"/>
                            <TextBlock Text="registered servers" Style="{StaticResource T.Muted}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel.Rust}" Margin="4,0,4,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource B.Success}" Effect="{StaticResource Glow.Soft}" VerticalAlignment="Center" Margin="0,0,6,0"
                                         Opacity="{Binding Opacity, Source={x:Static svc:PulseTicker.Current}}"/>
                                <TextBlock Text="ONLINE" Style="{StaticResource T.Pixel.Section}" FontSize="9"/>
                            </StackPanel>
                            <TextBlock Text="{Binding OnlineCount}" Style="{StaticResource T.CRT.Stat}" Foreground="{StaticResource B.Success}" Margin="0,6,0,0"/>
                            <TextBlock Text="reachable" Style="{StaticResource T.Muted}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel.Rust}" Margin="4,0,4,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource B.Danger}" Opacity="0.85" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="OFFLINE" Style="{StaticResource T.Pixel.Section}" FontSize="9"/>
                            </StackPanel>
                            <TextBlock Text="{Binding OfflineCount}" Style="{StaticResource T.CRT.Stat}" Foreground="{StaticResource B.Danger}" Margin="0,6,0,0"/>
                            <TextBlock Text="unreachable" Style="{StaticResource T.Muted}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel.Rust}" Margin="8,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource B.TextDim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="DISABLED" Style="{StaticResource T.Pixel.Section}" FontSize="9"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DisabledCount}" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource T.CRT.Stat}">
                                        <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DisabledCount}" Value="0">
                                                <Setter Property="Opacity" Value="0.4"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="not in enable list" Style="{StaticResource T.Muted}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Enabled-in-settings info -->
                <Border Style="{StaticResource Panel.Rust}" Margin="0,12,0,0" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="◈ enabledMcpjsonServers  (from settings.json)" Style="{StaticResource T.Pixel.Section}" FontSize="8"/>
                        <TextBlock Text="{Binding EnabledListText}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Ember}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Filter -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="FILTER" Style="{StaticResource T.Pixel.Section}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440" MinWidth="300"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Background="{StaticResource B.BG.Panel}">
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="14,10">
                    <TextBlock Text="◢ REGISTERED SERVERS" Style="{StaticResource T.Pixel.Section}"/>
                </Border>
                <ListBox ItemsSource="{Binding Filtered}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Live connection indicator: green pulses in sync via global PulseTicker, others static -->
                                    <Ellipse Grid.Column="0" Width="9" Height="9" Margin="0,0,10,0" VerticalAlignment="Center" Effect="{StaticResource Glow.Soft}">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource B.TextDim}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ConnectionState}" Value="ONLINE">
                                                        <Setter Property="Fill" Value="{StaticResource B.Success}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ConnectionState}" Value="OFFLINE">
                                                        <Setter Property="Fill" Value="{StaticResource B.Danger}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ConnectionState}" Value="OAUTH">
                                                        <Setter Property="Fill" Value="{StaticResource B.Warn}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ConnectionState}" Value="DISABLED">
                                                        <Setter Property="Fill" Value="{StaticResource B.TextDim}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ConnectionState}" Value="CHECKING">
                                                        <Setter Property="Fill" Value="{StaticResource B.TextMuted}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                        <Ellipse.Opacity>
                                            <MultiBinding Converter="{x:Static vm:McpDotOpacityConverter.Instance}">
                                                <Binding Path="ConnectionState"/>
                                                <Binding Path="Opacity" Source="{x:Static svc:PulseTicker.Current}"/>
                                            </MultiBinding>
                                        </Ellipse.Opacity>
                                    </Ellipse>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource T.Body}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <!-- Right-side status badge removed — dot color + ConnectionState carry the state signal now -->
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding TransportText}" FontFamily="{StaticResource Font.Pixel}" FontSize="7" Foreground="{StaticResource B.Ember}"/>
                                    <TextBlock Text=" · " Foreground="{StaticResource B.TextDim}" Margin="4,0"/>
                                    <TextBlock Text="{Binding ScopeText}" FontFamily="{StaticResource Font.Pixel}" FontSize="7" Foreground="{StaticResource B.TextMuted}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding EndpointText}" Style="{StaticResource T.Muted}" FontFamily="{StaticResource Font.Mono}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Style="{StaticResource Splitter.Vertical}"/>

            <DockPanel Grid.Column="2" Background="{StaticResource B.BG.Sunken}">
                <Border DockPanel.Dock="Top" Background="{StaticResource B.BG.Panel}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="16,12">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding ToggleEnabledCommand}" CommandParameter="{Binding Selected}"
                                Visibility="{Binding Selected.CanToggle, Converter={x:Static vm:BoolToVisibility.Instance}, FallbackValue=Collapsed}"
                                Margin="0,0,6,0" ToolTip="Add/remove from enabledMcpjsonServers (restart Claude Code to apply)">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Btn.Pixel.Primary}">
                                    <Setter Property="Content" Value="ENABLE"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Selected.EnabledInSettings}" Value="True">
                                            <Setter Property="Content" Value="DISABLE"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="OPEN SOURCE FILE" Style="{StaticResource Btn.Pixel}" Command="{Binding OpenSourceFileCommand}"/>
                        <TextBlock Text="{Binding Selected.SourceFile}" Style="{StaticResource T.Mono}" FontSize="12" Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- DETAIL toggle header (AGENTS-style clickable full-row) -->
                <Button DockPanel.Dock="Top" Command="{Binding ToggleDetailCommand}"
                        HorizontalContentAlignment="Stretch" Cursor="Hand" Padding="0"
                        ToolTip="Toggle DETAIL section">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{StaticResource B.BG.Panel}" Padding="20,10"
                                    BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" TargetName="Bd" Value="{StaticResource B.BG.Hover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="◢ DETAIL" Style="{StaticResource T.Pixel.Section}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" FontFamily="{StaticResource Font.Mono}" FontSize="14"
                                   Foreground="{StaticResource B.Ember}" VerticalAlignment="Center" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="»"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDetailCollapsed}" Value="True">
                                            <Setter Property="Text" Value="«"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>

                <!-- COLLAPSIBLE: only the header card (name + status + description) folds via DETAIL toggle -->
                <Border DockPanel.Dock="Top" Padding="20,16" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Background="{StaticResource B.BG.Panel}"
                        Visibility="{Binding IsDetailCollapsed, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◆" FontSize="14" Foreground="{StaticResource B.Rust}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Selected.Name, TargetNullValue='(no server selected)'}" FontFamily="{StaticResource Font.CRT}" FontSize="28" Foreground="{StaticResource B.Ember}" Effect="{StaticResource Glow.Soft}" VerticalAlignment="Center"/>
                            <Border Padding="8,5" Margin="14,2,0,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource B.RustDim}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Selected.ConnectionState}" Value="ONLINE">
                                                <Setter Property="Background" Value="{StaticResource B.Success}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Selected.ConnectionState}" Value="OFFLINE">
                                                <Setter Property="Background" Value="{StaticResource B.Danger}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Selected.ConnectionState}" Value="OAUTH">
                                                <Setter Property="Background" Value="{StaticResource B.Warn}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Selected.ConnectionState, FallbackValue='—'}" FontFamily="{StaticResource Font.Pixel}" FontSize="8" Foreground="{StaticResource B.BG.Primary}" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Selected.TransportText, TargetNullValue='—'}" FontFamily="{StaticResource Font.Pixel}" FontSize="8" Foreground="{StaticResource B.Ember}" VerticalAlignment="Center" Margin="14,2,0,0"/>
                            <TextBlock Text="▌" Foreground="{StaticResource B.RustDim}" FontFamily="{StaticResource Font.Pixel}" FontSize="8" VerticalAlignment="Center" Margin="8,2,8,0"/>
                            <TextBlock Text="{Binding Selected.ScopeText, TargetNullValue='—'}" FontFamily="{StaticResource Font.Pixel}" FontSize="8" Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Selected.DescriptionText}" Style="{StaticResource T.Body}" FontSize="13" TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,0" Foreground="{StaticResource B.Text}"/>
                    </StackPanel>
                </Border>

                <!-- AUTH notice (always visible when applicable, not tied to DETAIL toggle) -->
                <Border DockPanel.Dock="Top" Padding="20,10" Background="#1F2A1F" BorderBrush="{StaticResource B.Warn}" BorderThickness="0,0,0,1"
                        Visibility="{Binding Selected.NeedsAuth, Converter={x:Static vm:BoolToVisibility.Instance}, FallbackValue=Collapsed}">
                    <StackPanel>
                        <TextBlock Text="⚠ AUTHORIZATION REQUIRED" FontFamily="{StaticResource Font.Pixel}" FontSize="8" Foreground="{StaticResource B.Warn}"/>
                        <TextBlock Style="{StaticResource T.Body}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="이 서버는 OAuth 인증이 필요한 claude.ai 커넥터입니다. claude.ai 커넥터 설정에서 인증을 완료해야 실제 도구를 사용할 수 있습니다."/>
                        <TextBlock Style="{StaticResource T.Muted}" Margin="0,6,0,0">
                            <Run Text="cached at: "/><Run Text="{Binding Selected.AuthCacheTs, Mode=OneWay, FallbackValue=''}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ALWAYS VISIBLE (not collapsible): endpoint · args · env · metadata in the original inline style -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="ENDPOINT" Style="{StaticResource T.Pixel.Section}" FontSize="8"/>
                        <TextBox Text="{Binding Selected.EndpointText, Mode=OneWay, FallbackValue=''}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,6,0,14"/>

                        <StackPanel Visibility="{Binding Selected.ArgsList.Count, Converter={x:Static vm:IntPositiveToVisibility.Instance}, FallbackValue=Collapsed}">
                            <TextBlock Text="ARGS" Style="{StaticResource T.Pixel.Section}" FontSize="8"/>
                            <ItemsControl ItemsSource="{Binding Selected.ArgsList}" Margin="0,6,0,14">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource B.Text}" Margin="12,1,0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding Selected.EnvList.Count, Converter={x:Static vm:IntPositiveToVisibility.Instance}, FallbackValue=Collapsed}">
                            <TextBlock Text="ENV" Style="{StaticResource T.Pixel.Section}" FontSize="8"/>
                            <ItemsControl ItemsSource="{Binding Selected.EnvList}" Margin="0,6,0,14">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="12,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Key}" FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource B.Ember}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource B.Text}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="METADATA" Style="{StaticResource T.Pixel.Section}" FontSize="8"/>
                        <Grid Margin="0,6,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="transport" Style="{StaticResource T.Muted}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Selected.TransportText, FallbackValue='—'}" Style="{StaticResource T.Mono}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="scope" Style="{StaticResource T.Muted}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.ScopeText, FallbackValue='—'}" Style="{StaticResource T.Mono}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="workspace" Style="{StaticResource T.Muted}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.WorkspaceText, FallbackValue='(global)'}" Style="{StaticResource T.Mono}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="source file" Style="{StaticResource T.Muted}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selected.SourceFile, FallbackValue='—'}" Style="{StaticResource T.Mono}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="in enable list?" Style="{StaticResource T.Muted}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Selected.EnabledInSettings, FallbackValue='—'}" Style="{StaticResource T.Mono}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
