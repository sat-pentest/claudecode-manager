<UserControl x:Class="ClaudeCodeManager.App.Views.ClaudeMdView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ClaudeCodeManager.App.ViewModels"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:helper="clr-namespace:ClaudeCodeManager.App.Services"
             xmlns:svc="clr-namespace:ClaudeCodeManager.App.Services"
             xmlns:views="clr-namespace:ClaudeCodeManager.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:ClaudeMdViewModel}"
             mc:Ignorable="d">

    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find"/>
    </UserControl.InputBindings>

    <UserControl.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindExecuted"/>
    </UserControl.CommandBindings>

    <Grid Background="{StaticResource B.BG.Primary}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*" MinWidth="320"/>
            <ColumnDefinition x:Name="OutlineSplitterColumn" Width="4"/>
            <ColumnDefinition x:Name="OutlineColumn" Width="320" MinWidth="0"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: file list + profiles + split panel -->
        <DockPanel Background="{StaticResource B.BG.Panel}">
            <TextBlock DockPanel.Dock="Top" Text="◢ TARGETS" Style="{StaticResource T.Pixel.Section}" Margin="16,16,0,10"/>
            <ListBox DockPanel.Dock="Top" Height="120" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" Margin="10,0,10,8" Background="{StaticResource B.BG.Sunken}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" FontFamily="{StaticResource Font.Mono}" FontSize="14"/>
                            <TextBlock Text="{Binding Path}" Style="{StaticResource T.Muted}" FontSize="13" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock DockPanel.Dock="Top" Text="◢ PROFILES" Style="{StaticResource T.Pixel.Section}" Margin="16,4,0,8"/>
            <ListBox DockPanel.Dock="Top" Height="180" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Margin="10,0,10,6" Background="{StaticResource B.BG.Sunken}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Background="Transparent"
                                        MouseLeftButtonDown="OnProfileNameMouseDown"
                                        ToolTip="Double-click name to rename this profile">
                                <!-- 활성 프로필 = 초록 점멸 닷(앱 전역 LIVE 닷과 동일 언어), 비활성 = 딤 -->
                                <Ellipse Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center"
                                         svc:PulseBehavior.IsActive="{Binding IsActive}">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource B.TextDim}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource B.Success}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value><DropShadowEffect Color="#7CC45A" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/></Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Mono}" FontSize="14" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource B.Ember}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Padding="5,4,5,4" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Background="{StaticResource B.Success}"
                                        svc:PulseBehavior.IsActive="{Binding IsActive}"
                                        Visibility="{Binding IsActive, Converter={x:Static vm:BoolToVisibility.Instance}}">
                                    <TextBlock Text="ACTIVE" FontFamily="{StaticResource Font.UI}" FontWeight="Medium" FontSize="11" Foreground="{StaticResource B.BG.Primary}" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding IsActive, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
                                <Button Content="USE" Style="{StaticResource Btn.Pixel.Primary}" Padding="6,2" FontSize="12"
                                        Command="{Binding DataContext.ActivateProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Margin="0,0,4,0"/>
                                <Button Content="X" Style="{StaticResource Btn.Pixel.Danger}" Padding="6,2" FontSize="12"
                                        Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel DockPanel.Dock="Top" Margin="10,0,10,10">
                <TextBlock Text="save current as new profile" Style="{StaticResource T.Muted}" FontSize="12" Margin="0,2,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SaveAsProfileCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="SAVE" Style="{StaticResource Btn.Pixel}" Command="{Binding SaveAsProfileCommand}" Margin="4,0,0,0"/>
                </Grid>
                <TextBlock Text="{Binding ProfileError}" Style="{StaticResource T.Muted}" FontSize="12" Foreground="{StaticResource B.Danger}" Margin="0,4,0,0"
                           Visibility="{Binding ProfileError, Converter={x:Static vm:NullToVisibility.Instance}}"/>
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" Text="◢ SPLIT INTO FILES" Style="{StaticResource T.Pixel.Section}" Margin="16,4,0,10"/>
            <StackPanel DockPanel.Dock="Top" Margin="10,0">
                <TextBlock Text="subdir" Style="{StaticResource T.Muted}" Margin="0,4"/>
                <TextBox Text="{Binding SplitSubdir, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="split at heading level" Style="{StaticResource T.Muted}" Margin="0,8,0,4"/>
                <TextBox Text="{Binding SplitLevel, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="PREVIEW SPLIT" Style="{StaticResource Btn.Pixel}" Command="{Binding PreviewSplitCommand}" Margin="0,12,0,4" HorizontalAlignment="Stretch"/>
                <Button Content="APPLY SPLIT" Style="{StaticResource Btn.Pixel.Primary}" Command="{Binding ApplySplitCommand}" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </DockPanel>

        <GridSplitter Grid.Column="1" Style="{StaticResource Splitter.Vertical}"/>

        <!-- CENTER: editor -->
        <DockPanel Grid.Column="2" Background="{StaticResource B.BG.Sunken}">
            <Border DockPanel.Dock="Top" Background="{StaticResource B.BG.Panel}" Padding="14,8" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <Button Content="SAVE" Style="{StaticResource Btn.Pixel.Primary}" Command="{Binding SaveCommand}" Margin="0,0,6,0"/>
                    <Button Content="RELOAD" Style="{StaticResource Btn.Pixel}" Command="{Binding ReloadCommand}" Margin="0,0,6,0"/>
                    <Button Command="{Binding TogglePreviewCommand}" Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Btn.Pixel}">
                                <Setter Property="Content" Value="PREVIEW"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPreviewMode}" Value="True">
                                        <Setter Property="Content" Value="EDIT"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Padding="6,4,6,4" Margin="4,0,0,0" VerticalAlignment="Center"
                            Background="{StaticResource B.RustDim}"
                            Visibility="{Binding IsEditingProfile, Converter={x:Static vm:BoolToVisibility.Instance}}">
                        <TextBlock Text="PROFILE" FontFamily="{StaticResource Font.UI}" FontWeight="Medium" FontSize="11" Foreground="{StaticResource B.Text}" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="●" Foreground="{StaticResource B.Warn}" VerticalAlignment="Center" Margin="10,0" Visibility="{Binding IsDirty, Converter={x:Static vm:BoolToVisibility.Instance}}"/>
                    <TextBlock Text="{Binding EditingFilePath}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <TabControl x:Name="EditorTabs" Background="Transparent" BorderThickness="0">
                <TabItem Header="EDITOR">
                    <Grid>
                        <avalon:TextEditor x:Name="Editor"
                                           FontFamily="{StaticResource Font.Code}"
                                           FontSize="13.5"
                                           Foreground="{StaticResource B.Text}"
                                           Background="{StaticResource B.BG.Sunken}"
                                           LineNumbersForeground="{StaticResource B.TextDim}"
                                           ShowLineNumbers="True"
                                           WordWrap="False"
                                           SyntaxHighlighting="MarkdownRust"
                                           helper:AvalonEditHelper.BindableText="{Binding EditorContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Visibility="{Binding IsPreviewMode, Converter={x:Static vm:InverseBoolToVisibility.Instance}}"/>
                        <FlowDocumentScrollViewer x:Name="Preview"
                                                  Background="{StaticResource B.BG.Sunken}"
                                                  Foreground="{StaticResource B.Text}"
                                                  Visibility="{Binding IsPreviewMode, Converter={x:Static vm:BoolToVisibility.Instance}}"
                                                  IsToolBarVisible="False">
                            <FlowDocumentScrollViewer.CommandBindings>
                                <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindExecuted"/>
                            </FlowDocumentScrollViewer.CommandBindings>
                        </FlowDocumentScrollViewer>
                        <views:FindOverlay x:Name="Find" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,12,20,0"/>
                    </Grid>
                </TabItem>
                <TabItem Header="SPLIT PLAN">
                    <ScrollViewer>
                        <TextBlock Text="{Binding SplitPreview}" Style="{StaticResource T.Mono}" Padding="16" TextWrapping="NoWrap"/>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>

        <GridSplitter Grid.Column="3" Style="{StaticResource Splitter.Vertical}"
                      Visibility="{Binding IsOutlineCollapsed, Converter={x:Static vm:InverseBoolToVisibility.Instance}}"/>

        <!-- RIGHT: outline (collapsible) -->
        <DockPanel Grid.Column="4" Background="{StaticResource B.BG.Panel}">
            <!-- Whole header is a clickable toggle -->
            <Button DockPanel.Dock="Top" Command="{Binding ToggleOutlineCommand}"
                    HorizontalContentAlignment="Stretch" Cursor="Hand" Padding="0"
                    ToolTip="Toggle outline (click to collapse/expand)">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="10,14,10,10"
                                BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
                            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="Bd" Value="{StaticResource B.BG.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="◢ OUTLINE" Style="{StaticResource T.Pixel.Section}" VerticalAlignment="Center" Margin="6,0,0,0"
                               Visibility="{Binding IsOutlineCollapsed, Converter={x:Static vm:InverseBoolToVisibility.Instance}}"/>
                    <TextBlock Grid.Column="1" FontFamily="{StaticResource Font.Mono}" FontSize="15"
                               Foreground="{StaticResource B.Ember}" VerticalAlignment="Center"
                               HorizontalAlignment="Center" Margin="4,0" FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="»"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOutlineCollapsed}" Value="True">
                                        <Setter Property="Text" Value="«"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Button>

            <!-- Vertical label when collapsed (also clickable to expand) -->
            <Button DockPanel.Dock="Top" Command="{Binding ToggleOutlineCommand}"
                    HorizontalContentAlignment="Stretch" Cursor="Hand" Padding="0"
                    Visibility="{Binding IsOutlineCollapsed, Converter={x:Static vm:BoolToVisibility.Instance}}"
                    ToolTip="Click to expand outline">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="0,20,0,20">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="Bd" Value="{StaticResource B.BG.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="OUTLINE" Style="{StaticResource T.Pixel.Section}" FontSize="12" HorizontalAlignment="Center">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </Button>

            <!-- Outline list -->
            <ListBox x:Name="OutlineList" ItemsSource="{Binding Outline}" Background="Transparent" BorderThickness="0" Margin="8,0,8,8"
                     SelectionChanged="OnOutlineSelectionChanged"
                     Visibility="{Binding IsOutlineCollapsed, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Level}" Width="22" Foreground="{StaticResource B.Rust}" FontFamily="{StaticResource Font.UI}" FontWeight="Medium" FontSize="15"/>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource T.Body}" FontSize="15" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>
