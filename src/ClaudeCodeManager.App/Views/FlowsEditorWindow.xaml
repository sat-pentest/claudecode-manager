<Window x:Class="ClaudeCodeManager.App.Views.FlowsEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:svc="clr-namespace:ClaudeCodeManager.App.Services"
        Title="Edit HARNESS Flows"
        Width="1100" Height="760"
        MinWidth="720" MinHeight="480"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource B.BG.Panel}"
        BorderBrush="{StaticResource B.Rust}"
        BorderThickness="1"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <!-- CaptionHeight=0 disables the default WPF caption band (was showing as a red stripe
         at the top); ResizeBorderThickness gives users a grabbable edge for resizing;
         GlassFrameThickness=0 removes the DWM glass edge. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <DockPanel>
        <!-- ═══ TITLE BAR (draggable) ═══ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource B.BG.Sunken}"
                Padding="18,10,10,10"
                BorderBrush="{StaticResource B.Border}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnHeaderMouseDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="▧" Foreground="{StaticResource B.Ember}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="EDIT HARNESS FLOWS"
                               FontFamily="{StaticResource Font.Pixel}" FontSize="10"
                               Foreground="{StaticResource B.Ember}"
                               Effect="{StaticResource Glow.Soft}"
                               TextOptions.TextRenderingMode="Aliased"
                               TextOptions.TextFormattingMode="Display"/>
                    <TextBlock x:Name="PathText"
                               FontFamily="{StaticResource Font.Mono}" FontSize="10"
                               Foreground="{StaticResource B.TextMuted}"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="2" Content="✕" Click="OnClose"
                        Background="Transparent" Foreground="{StaticResource B.TextMuted}"
                        BorderThickness="0" FontFamily="{StaticResource Font.Mono}" FontSize="14"
                        Width="36" Height="26" Cursor="Hand"
                        VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" TargetName="Bd" Value="{StaticResource B.Danger}"/>
                                    <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ TOOLBAR ═══ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource B.BG.Panel}" Padding="18,10"
                BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="SAVE" Click="OnSave"
                        Style="{StaticResource Btn.Pixel.Primary}"
                        MinWidth="90" Margin="0,0,8,0"/>
                <Button Content="REVERT" Click="OnRevert"
                        Style="{StaticResource Btn.Pixel}"
                        MinWidth="90" Margin="0,0,8,0"
                        ToolTip="Reload from disk, discard unsaved changes"/>
                <Button Content="INSERT FLOW TEMPLATE" Click="OnInsertTemplate"
                        Style="{StaticResource Btn.Pixel}"
                        MinWidth="180" Margin="0,0,8,0"
                        ToolTip="Insert a blank flow scaffold at the cursor"/>
                <Button Content="OPEN IN EXPLORER" Click="OnRevealInExplorer"
                        Style="{StaticResource Btn.Pixel}"
                        MinWidth="150" Margin="0,0,8,0"
                        ToolTip="Reveal the JSON file in File Explorer"/>
                <TextBlock x:Name="DirtyIndicator"
                           Text="●"
                           FontSize="14"
                           Foreground="{StaticResource B.Warn}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Visibility="Collapsed"
                           ToolTip="Unsaved changes"/>
            </StackPanel>
        </Border>

        <!-- ═══ STATUS BAR (bottom) ═══ -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource B.BG.Sunken}"
                Padding="18,8"
                BorderBrush="{StaticResource B.Border}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusPill" Padding="7,2" Margin="0,0,10,0"
                            Background="{StaticResource B.Success}">
                        <TextBlock x:Name="StatusPillText" Text="OK"
                                   FontFamily="{StaticResource Font.Pixel}" FontSize="7"
                                   Foreground="{StaticResource B.BG.Primary}"/>
                    </Border>
                    <TextBlock x:Name="StatusText"
                               Text="valid JSON · 0 flows"
                               FontFamily="{StaticResource Font.Mono}" FontSize="11"
                               Foreground="{StaticResource B.TextMuted}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="Ctrl+S 저장 · Esc 닫기"
                           Style="{StaticResource T.Muted}"
                           FontSize="10"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══ EDITOR ═══ -->
        <Grid Background="{StaticResource B.BG.Primary}">
            <avalon:TextEditor x:Name="Editor"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="14"
                               Background="{StaticResource B.BG.Primary}"
                               Foreground="{StaticResource B.Text}"
                               ShowLineNumbers="True"
                               SyntaxHighlighting="JavaScript"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"
                               Padding="12,10"
                               WordWrap="False"/>
        </Grid>
    </DockPanel>
</Window>
