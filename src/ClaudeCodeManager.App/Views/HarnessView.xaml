<UserControl x:Class="ClaudeCodeManager.App.Views.HarnessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ClaudeCodeManager.App.ViewModels"
             xmlns:svc="clr-namespace:ClaudeCodeManager.App.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:HarnessViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Section header (collapsible). ButtonTemplate: whole row is clickable, chevron on right rotates. -->
        <Style x:Key="SectionHeader" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="0,4,0,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="Bd" Value="{StaticResource B.BG.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Reusable card style for a HarnessNode. Click navigates to its owning module.
             Disabled state gets a dim overall opacity so inactive cards clearly recede
             behind active ones — matches MCP module visual language. -->
        <Style x:Key="NodeCard" TargetType="Button">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Command" Value="{Binding DataContext.NavigateNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Setter Property="CommandParameter" Value="{Binding}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource B.BG.Panel}"
                                BorderBrush="{StaticResource B.BorderSoft}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="Bd" Value="{StaticResource B.BG.Hover}"/>
                                <Setter Property="BorderBrush" TargetName="Bd" Value="{StaticResource B.Rust}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── ORCHESTRATION FLOW DIAGRAM ────────────────────────────────
             Flows are drawn as a left→right node graph: ENTRY ▸ step ▸ step.
             A node that is reachable holds full opacity with a rust border and a live
             packet running down its outgoing rail; an unreachable one recedes and its
             rail goes dashed-red with an ✕ — so a PARTIAL flow shows *which* hop is
             broken without having to read the step list. -->

        <!-- The node outline is a Rectangle rather than Border.BorderBrush because a node the
             request can never reach is drawn dashed, and a Border cannot dash its own edge. -->
        <Style x:Key="FlowNodeOutline" TargetType="Rectangle">
            <Setter Property="RadiusX" Value="2"/>
            <Setter Property="RadiusY" Value="2"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Stroke">
                <Setter.Value>
                    <MultiBinding Converter="{x:Static vm:FlowChainConverter.NodeStroke}">
                        <Binding Path="Owner.ChainProgress"/>
                        <Binding Path="Owner.ChainAlpha"/>
                        <Binding Path="Index"/>
                        <Binding Path="HopCount"/>
                        <Binding Path="IsReachable"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="StrokeDashArray">
                <Setter.Value>
                    <MultiBinding Converter="{x:Static vm:FlowChainConverter.NodeDash}">
                        <Binding Path="Owner.ChainProgress"/>
                        <Binding Path="Owner.ChainAlpha"/>
                        <Binding Path="Index"/>
                        <Binding Path="HopCount"/>
                        <Binding Path="IsReachable"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <MultiBinding Converter="{x:Static vm:FlowChainConverter.NodeGlow}">
                        <Binding Path="Owner.ChainProgress"/>
                        <Binding Path="Owner.ChainAlpha"/>
                        <Binding Path="Index"/>
                        <Binding Path="HopCount"/>
                        <Binding Path="IsReachable"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kind pill — same colour mapping the flow list used, so SKILL/AGENT/MCP stay
             recognisable now that they sit inside a node instead of a row. -->
        <Style x:Key="FlowKindPill" TargetType="Border">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="{StaticResource B.RustDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="SKILL">
                    <Setter Property="Background" Value="{StaticResource B.Ember}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="AGENT">
                    <Setter Property="Background" Value="{StaticResource B.Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="MCP">
                    <Setter Property="Background" Value="{StaticResource B.Warn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="EXTERNAL">
                    <Setter Property="Background" Value="{StaticResource B.TextMuted}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24" Background="{StaticResource B.BG.Primary}">
        <StackPanel>

            <!-- HEADER -->
            <Grid Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon.Module}" Data="{Binding Glyph, Converter={x:Static vm:StringToGeometry.Instance}}"/>
                    <TextBlock Text="HARNESS" Style="{StaticResource T.Module.Title}" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="  ▌  System orchestration overview" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource Btn.Pixel}" Content="REFRESH" Command="{Binding RefreshCommand}"/>
            </Grid>

            <!-- (ORCHESTRATION FLOWS 트리 다이어그램은 2026-10-07 사용자 요청으로 제거 — 리소스/VM 은 유지) -->
            <!-- ═══════════════════════════════════════════════════════
                 LAYER 1 · RUNTIME
                 ═══════════════════════════════════════════════════════ -->
            <Border BorderBrush="{StaticResource B.Border}" BorderThickness="1" Background="{StaticResource B.BG.Panel}" Padding="20,16" Margin="0,0,0,14">
                <StackPanel>
                    <Button Style="{StaticResource SectionHeader}" Command="{Binding ToggleLayer1Command}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="▤ LAYER 1 · RUNTIME" Style="{StaticResource T.Pixel.Section}" FontSize="13" Foreground="{StaticResource B.Ember}" VerticalAlignment="Center"/>
                                <TextBlock Text=" ▌ Claude Code 인프라 · 외부 도구 접속" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{StaticResource B.Ember}" VerticalAlignment="Center" Margin="0,0,4,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="▼"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLayer1Collapsed}" Value="True">
                                                <Setter Property="Text" Value="▶"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>

                    <StackPanel Visibility="{Binding IsLayer1Collapsed, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">

                    <!-- Environment stats row -->
                    <UniformGrid Columns="4" Rows="1" Margin="0,0,0,14" svc:Fx.StaggerChildren="True">
                        <Border BorderBrush="{StaticResource B.BorderSoft}" BorderThickness="1" Padding="12,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="STORAGE" Style="{StaticResource T.Pixel.Section}" FontSize="12"/>
                                <TextBlock Text="{Binding StorageText}" FontFamily="{StaticResource Font.UI}" FontWeight="Medium" FontSize="18" Foreground="{StaticResource B.Ember}" Margin="0,4,0,0"/>
                                <TextBlock Style="{StaticResource T.Muted}">
                                    <Run Text="{Binding SessionCount, Mode=OneWay}"/><Run Text=" sessions"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{StaticResource B.BorderSoft}" BorderThickness="1" Padding="12,10" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="RETENTION" Style="{StaticResource T.Pixel.Section}" FontSize="12"/>
                                <!-- VT323 renders ∞ tiny; use Segoe UI Symbol when infinite so the glyph reads clearly. -->
                                <TextBlock Text="{Binding RetentionText}" FontSize="26" Margin="0,4,0,0" Foreground="{StaticResource B.Text}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{StaticResource Font.UI}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RetentionIsInfinite}" Value="True">
                                                    <Setter Property="FontFamily" Value="Segoe UI Symbol, Segoe UI, IBM Plex Sans KR"/>
                                                    <Setter Property="FontWeight" Value="Light"/>
                                                    <Setter Property="Foreground" Value="{StaticResource B.Ember}"/>
                                                    <Setter Property="Effect" Value="{StaticResource Glow.Soft}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="cleanupPeriodDays" Style="{StaticResource T.Muted}"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{StaticResource B.BorderSoft}" BorderThickness="1" Padding="12,10" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="MEMORY" Style="{StaticResource T.Pixel.Section}" FontSize="12"/>
                                <TextBlock Text="{Binding MemoryCount}" FontFamily="{StaticResource Font.UI}" FontWeight="Medium" FontSize="18" Foreground="{StaticResource B.Text}" Margin="0,4,0,0"/>
                                <TextBlock Text="entries" Style="{StaticResource T.Muted}"/>
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{StaticResource B.BorderSoft}" BorderThickness="1" Padding="12,10" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="SNAPSHOTS" Style="{StaticResource T.Pixel.Section}" FontSize="12"/>
                                <TextBlock Text="{Binding SnapshotCount}" FontFamily="{StaticResource Font.UI}" FontWeight="Medium" FontSize="18" Foreground="{StaticResource B.Text}" Margin="0,4,0,0"/>
                                <TextBlock Text="git commits" Style="{StaticResource T.Muted}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- MCP servers grid -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="◈ MCP SERVERS" Style="{StaticResource T.Pixel.Section}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource T.Muted}" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Run Text="{Binding McpOnline, Mode=OneWay}"/><Run Text=" enabled · "/><Run Text="{Binding McpDisabled, Mode=OneWay}"/><Run Text=" disabled · "/><Run Text="{Binding McpTotal, Mode=OneWay}"/><Run Text=" total"/>
                        </TextBlock>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding McpNodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NodeCard}" Width="215">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Fill driven by ConnectionState (probe result) — mirrors MCP module semantics
                                                 so HARNESS reflects actual reachability, not just "configured to be enabled". -->
                                            <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Effect="{StaticResource Glow.Soft}"
                                                     svc:PulseBehavior.IsActive="{Binding IsActive}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource B.TextDim}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ConnectionState}" Value="ONLINE">
                                                                <Setter Property="Fill" Value="{StaticResource B.Success}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ConnectionState}" Value="OFFLINE">
                                                                <Setter Property="Fill" Value="{StaticResource B.Danger}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ConnectionState}" Value="OAUTH">
                                                                <Setter Property="Fill" Value="{StaticResource B.Warn}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ConnectionState}" Value="CHECKING">
                                                                <Setter Property="Fill" Value="{StaticResource B.TextMuted}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Mono}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource T.Muted}" FontSize="12" Margin="15,3,0,0"/>
                                        <!-- Badge in rust color (matches MCP module DISABLED look — visually informative, not dimmed) -->
                                        <TextBlock Text="{Binding StateBadge}" FontFamily="{StaticResource Font.UI}" FontWeight="Medium" FontSize="11" Foreground="{StaticResource B.Rust}" Margin="15,3,0,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════
                 LAYER 2 · TASK ORCHESTRATION
                 ═══════════════════════════════════════════════════════ -->
            <Border BorderBrush="{StaticResource B.Border}" BorderThickness="1" Background="{StaticResource B.BG.Panel}" Padding="20,16" Margin="0,0,0,14">
                <StackPanel>
                    <Button Style="{StaticResource SectionHeader}" Command="{Binding ToggleLayer2Command}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="▥ LAYER 2 · TASK ORCHESTRATION" Style="{StaticResource T.Pixel.Section}" FontSize="13" Foreground="{StaticResource B.Ember}" VerticalAlignment="Center"/>
                                <TextBlock Text=" ▌ 스킬 · 에이전트 · 릴레이 체계" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{StaticResource B.Ember}" VerticalAlignment="Center" Margin="0,0,4,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="▼"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLayer2Collapsed}" Value="True">
                                                <Setter Property="Text" Value="▶"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>

                    <Grid Visibility="{Binding IsLayer2Collapsed, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- SKILLS column -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="◈ SKILLS" Style="{StaticResource T.Pixel.Section}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource T.Muted}" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <Run Text="{Binding SkillEnabled, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding SkillTotal, Mode=OneWay}"/><Run Text=" active"/>
                                </TextBlock>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding SkillNodes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource NodeCard}" HorizontalAlignment="Stretch">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Effect="{StaticResource Glow.Soft}"
                                                             svc:PulseBehavior.IsActive="{Binding IsActive}">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{StaticResource B.TextDim}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource B.Success}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Mono}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource B.Text}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource T.Muted}" FontSize="12" Margin="15,3,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- AGENTS column -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="◈ AGENTS" Style="{StaticResource T.Pixel.Section}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource T.Muted}" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <Run Text="{Binding AgentEnabled, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding AgentTotal, Mode=OneWay}"/><Run Text=" active"/>
                                </TextBlock>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding AgentNodes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource NodeCard}" HorizontalAlignment="Stretch">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Effect="{StaticResource Glow.Soft}"
                                                             svc:PulseBehavior.IsActive="{Binding IsActive}">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{StaticResource B.TextDim}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource B.Success}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Mono}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource B.Text}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource T.Muted}" FontSize="12" Margin="15,3,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════
                 LAYER 3 · WORKFLOWS (.mjs scripts in ~/.claude/workflows/)
                 ═══════════════════════════════════════════════════════ -->
            <Border BorderBrush="{StaticResource B.Border}" BorderThickness="1" Background="{StaticResource B.BG.Panel}" Padding="20,16" Margin="0,0,0,14">
                <StackPanel>
                    <Button Style="{StaticResource SectionHeader}" Command="{Binding ToggleLayer3Command}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="▤ LAYER 3 · WORKFLOWS" Style="{StaticResource T.Pixel.Section}" FontSize="13" Foreground="{StaticResource B.Ember}" VerticalAlignment="Center"/>
                                <TextBlock Text=" ▌ .mjs 스크립트 · 다중 에이전트 자율 오케스트레이션" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Style="{StaticResource T.Muted}" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <Run Text="{Binding WorkflowEnabled, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding WorkflowTotal, Mode=OneWay}"/><Run Text=" active"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{StaticResource B.Ember}" VerticalAlignment="Center" Margin="0,0,4,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="▼"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLayer3Collapsed}" Value="True">
                                                <Setter Property="Text" Value="▶"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>

                    <ItemsControl ItemsSource="{Binding WorkflowNodes}"
                                  Visibility="{Binding IsLayer3Collapsed, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NodeCard}" HorizontalAlignment="Stretch">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Effect="{StaticResource Glow.Soft}"
                                                     svc:PulseBehavior.IsActive="{Binding IsActive}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource B.TextDim}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource B.Success}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Mono}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource B.Text}"/>
                                            <Border Padding="5,2,5,3" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Background="{StaticResource B.RustDim}"
                                                    Visibility="{Binding IsActive, Converter={x:Static vm:InverseBoolToVisibility.Instance}}">
                                                <TextBlock Text="OFF" FontFamily="{StaticResource Font.UI}" FontWeight="Medium" FontSize="11" Foreground="{StaticResource B.Text}" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource T.Muted}" FontSize="12" Margin="15,3,0,0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
