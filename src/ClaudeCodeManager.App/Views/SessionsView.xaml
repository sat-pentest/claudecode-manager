<UserControl x:Class="ClaudeCodeManager.App.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ClaudeCodeManager.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:SessionsViewModel}"
             mc:Ignorable="d">

    <Grid Background="{StaticResource B.BG.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER: aggregate stats + prune toolbar -->
        <Border Grid.Row="0" Background="{StaticResource B.BG.Panel}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Icon.Module}" Data="{Binding Glyph, Converter={x:Static vm:StringToGeometry.Instance}}"/>
                        <TextBlock Text="SESSIONS" Style="{StaticResource T.Pixel.Section}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="  ▌  ~/.claude/projects/" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource Btn.Pixel}" Content="OPEN FOLDER" Command="{Binding OpenProjectsRootCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource Btn.Pixel}" Content="REFRESH" Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                </Grid>

                <UniformGrid Columns="4" Rows="1">
                    <Border Style="{StaticResource Panel.Rust}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="TOTAL SIZE" Style="{StaticResource T.Pixel.Section}" FontSize="9"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding TotalSize}" Style="{StaticResource T.CRT.Stat}"/>
                                <TextBlock Text="{Binding WarningLevel}" FontFamily="{StaticResource Font.Pixel}" FontSize="7" VerticalAlignment="Bottom" Margin="8,0,0,10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource B.Success}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WarningLevel}" Value="WARN"><Setter Property="Foreground" Value="{StaticResource B.Warn}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding WarningLevel}" Value="DANGER"><Setter Property="Foreground" Value="{StaticResource B.Danger}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Style="{StaticResource T.Muted}">
                                <Run Text="{Binding TotalSessionFiles, Mode=OneWay}"/><Run Text=" JSONL files"/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding DiskDriveLabel}" FontFamily="{StaticResource Font.Pixel}" FontSize="7" Foreground="{StaticResource B.RustDim}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DiskFreeText}" Style="{StaticResource T.Muted}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel.Rust}" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="PROJECTS" Style="{StaticResource T.Pixel.Section}" FontSize="9"/>
                            <TextBlock Text="{Binding TotalProjects}" Style="{StaticResource T.CRT.Stat}" Margin="0,6,0,0"/>
                            <TextBlock Text="tracked" Style="{StaticResource T.Muted}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel.Rust}" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="RETENTION" Style="{StaticResource T.Pixel.Section}" FontSize="9"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding RetentionValue}" FontSize="36" Foreground="{StaticResource B.Text}" VerticalAlignment="Bottom">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="{StaticResource Font.CRT}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RetentionInfinite}" Value="True">
                                                    <Setter Property="FontFamily" Value="Segoe UI Symbol, Segoe UI, IBM Plex Sans KR"/>
                                                    <Setter Property="FontWeight" Value="Light"/>
                                                    <Setter Property="Foreground" Value="{StaticResource B.Ember}"/>
                                                    <Setter Property="Effect" Value="{StaticResource Glow.Soft}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding RetentionLabel}" Style="{StaticResource T.Muted}" VerticalAlignment="Bottom" Margin="8,0,0,10"/>
                            </StackPanel>
                            <TextBlock Text="cleanupPeriodDays" Style="{StaticResource T.Muted}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel.Rust}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="OLDEST / NEWEST" Style="{StaticResource T.Pixel.Section}" FontSize="9"/>
                            <TextBlock Text="{Binding OldestSession}" Style="{StaticResource T.Mono}" FontSize="13" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding NewestSession}" Style="{StaticResource T.Muted}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Prune toolbar -->
                <Border Style="{StaticResource Panel.Rust}" Margin="0,12,0,0" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="◈ PRUNE" Style="{StaticResource T.Pixel.Section}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="older than " Style="{StaticResource T.Mono}" Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Center" Margin="14,0,4,0"/>
                        <TextBox Grid.Column="2" Text="{Binding PruneDays, UpdateSourceTrigger=PropertyChanged}" Width="60" VerticalAlignment="Center" HorizontalContentAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text=" days" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <Button Grid.Column="4" Style="{StaticResource Btn.Pixel}" Content="PRUNE SELECTED" Command="{Binding PruneProjectCommand}" Margin="0,0,8,0"/>
                        <Button Grid.Column="5" Style="{StaticResource Btn.Pixel.Danger}" Content="PRUNE ALL PROJECTS" Command="{Binding PruneAllCommand}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- BODY: projects list | session detail -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440" MinWidth="280"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Background="{StaticResource B.BG.Panel}">
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="◢ PROJECTS BY SIZE" Style="{StaticResource T.Pixel.Section}"/>
                        <TextBlock Text="sorted largest first" Style="{StaticResource T.Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Slug}" Style="{StaticResource T.Body}" FontFamily="{StaticResource Font.Mono}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontFamily="{StaticResource Font.CRT}" FontSize="16" Foreground="{StaticResource B.Ember}" Margin="8,0,0,0"/>
                                </Grid>
                                <!-- Relative comparison bar (largest project = 100%). Hidden when only 1 project — meaningless. -->
                                <Border Height="3" Background="{StaticResource B.BorderSoft}" Margin="0,4,0,0" CornerRadius="0"
                                        Visibility="{Binding DataContext.ShowRelativeBars, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static vm:BoolToVisibility.Instance}}"
                                        ToolTip="relative size vs largest project (comparison only, not a capacity limit)">
                                    <Border HorizontalAlignment="Left" Background="{StaticResource B.RustDim}" Opacity="0.7"
                                            Width="{Binding BarPct, Converter={x:Static vm:PercentToWidthConverter.Instance}, ConverterParameter=380}"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Style="{StaticResource T.Muted}">
                                        <Run Text="{Binding SessionCount, Mode=OneWay}"/>
                                        <Run Text=" sessions · "/>
                                        <Run Text="{Binding Newest, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Style="{StaticResource Splitter.Vertical}"/>

            <DockPanel Grid.Column="2" Background="{StaticResource B.BG.Sunken}">
                <Border DockPanel.Dock="Top" Background="{StaticResource B.BG.Panel}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▸" Foreground="{StaticResource B.Ember}" FontFamily="{StaticResource Font.CRT}" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SelectedProject.Slug, TargetNullValue='(no project selected)'}"
                                           FontFamily="{StaticResource Font.Mono}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource B.Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="28,4,0,0">
                                <TextBlock FontFamily="{StaticResource Font.Pixel}" FontSize="8" Foreground="{StaticResource B.TextMuted}">
                                    <Run Text="{Binding SelectedProject.SessionCount, Mode=OneWay, TargetNullValue='0'}"/>
                                    <Run Text=" SESSIONS"/>
                                </TextBlock>
                                <TextBlock Text=" ▌ " Foreground="{StaticResource B.RustDim}" VerticalAlignment="Center" Margin="4,0"/>
                                <TextBlock Text="{Binding SelectedProject.SizeText, TargetNullValue='—'}" FontFamily="{StaticResource Font.CRT}" FontSize="16" Foreground="{StaticResource B.Ember}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Btn.Pixel}" Content="OPEN" Command="{Binding OpenProjectInExplorerCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource Btn.Pixel.Danger}" Content="DELETE SELECTED"
                                    Command="{Binding DeleteSelectedSessionsCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=FilesList}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <ListView x:Name="FilesList" ItemsSource="{Binding SelectedProject.Sessions}" SelectedItem="{Binding SelectedSession}" BorderThickness="0" Background="Transparent"
                          SelectionMode="Extended"
                          GridViewColumnHeader.Click="OnColumnHeaderClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Session" Width="420">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding FileName}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="◈" FontFamily="{StaticResource Font.Mono}" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource B.Rust}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsJsonl}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
                                                                <Setter Property="Text" Value="•"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayLabel}" FontFamily="{StaticResource Font.Mono}" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasAiTitle}" Value="False">
                                                                    <Setter Property="Foreground" Value="{StaticResource B.TextMuted}"/>
                                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding FileName}" FontFamily="{StaticResource Font.Mono}" FontSize="10" Foreground="{StaticResource B.TextDim}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Size" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}" FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource B.Ember}" HorizontalAlignment="Right"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Modified" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ModifiedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource B.TextMuted}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Age" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource B.TextMuted}" HorizontalAlignment="Right">
                                            <Run Text="{Binding AgeDays, Mode=OneWay}"/><Run Text="d"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
