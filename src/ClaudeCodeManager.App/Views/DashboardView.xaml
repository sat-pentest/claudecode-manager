<UserControl x:Class="ClaudeCodeManager.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ClaudeCodeManager.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24" Background="{StaticResource B.BG.Primary}">
        <StackPanel>
            <!-- Clickable dashboard stat cards. Each Button navigates to its owning module.
                 Reusable local style below wraps a Panel.Rust border with hover glow.
                 (Property elements must precede content children — placed at top of StackPanel.) -->
            <StackPanel.Resources>
                <Style x:Key="DashCard" TargetType="Button">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Style="{StaticResource Panel.Rust}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Ember}"/>
                                        <Setter TargetName="Bd" Property="Effect" Value="{StaticResource Glow.Soft}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </StackPanel.Resources>

            <Grid Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Icon.Module}" Data="{Binding Glyph, Converter={x:Static vm:StringToGeometry.Instance}}"/>
                    <TextBlock Text="DASHBOARD" Style="{StaticResource T.Pixel.Section}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource Btn.Pixel}" Content="REFRESH" Command="{Binding RefreshCommand}"/>
            </Grid>

            <!-- Row 1: content-config cards (things the user actively curates) -->
            <UniformGrid Columns="4" Rows="1" Margin="0,0,0,8">
                <Button Style="{StaticResource DashCard}" Command="{Binding NavigateToCommand}" CommandParameter="MEMO" Margin="0,0,8,0" ToolTip="→ MEMORY 모듈">
                    <StackPanel>
                        <TextBlock Text="MEMORY" Style="{StaticResource T.Pixel.Section}" FontSize="9"/>
                        <TextBlock Text="{Binding TotalMemoryEntries}" Style="{StaticResource T.CRT.Stat}" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource T.Muted}">
                            <Run Text="across "/><Run Text="{Binding TotalProjects, Mode=OneWay}"/><Run Text=" projects"/>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DashCard}" Command="{Binding NavigateToCommand}" CommandParameter="SKIL" Margin="4,0,4,0" ToolTip="→ SKILLS 모듈">
                    <StackPanel>
                        <TextBlock Text="SKILLS" Style="{StaticResource T.Pixel.Section}" FontSize="9"/>
                        <TextBlock Text="{Binding TotalSkills}" Style="{StaticResource T.CRT.Stat}" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource T.Muted}">
                            <Run Text="{Binding ActiveSkills, Mode=OneWay}" Foreground="{StaticResource B.Success}"/><Run Text=" 활성 · "/><Run Text="{Binding DisabledSkills, Mode=OneWay}"/><Run Text=" 비활성"/>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DashCard}" Command="{Binding NavigateToCommand}" CommandParameter="AGNT" Margin="4,0,4,0" ToolTip="→ AGENTS 모듈">
                    <StackPanel>
                        <TextBlock Text="AGENTS" Style="{StaticResource T.Pixel.Section}" FontSize="9"/>
                        <TextBlock Text="{Binding TotalAgents}" Style="{StaticResource T.CRT.Stat}" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource T.Muted}">
                            <Run Text="{Binding ActiveAgents, Mode=OneWay}" Foreground="{StaticResource B.Success}"/><Run Text=" 활성 · "/><Run Text="{Binding DisabledAgents, Mode=OneWay}"/><Run Text=" 비활성"/>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DashCard}" Command="{Binding NavigateToCommand}" CommandParameter="WFLW" Margin="8,0,0,0" ToolTip="→ WORKFLOWS 모듈">
                    <StackPanel>
                        <TextBlock Text="WORKFLOWS" Style="{StaticResource T.Pixel.Section}" FontSize="9"/>
                        <TextBlock Text="{Binding TotalWorkflows}" Style="{StaticResource T.CRT.Stat}" Margin="0,6,0,0"/>
                        <TextBlock Style="{StaticResource T.Muted}">
                            <Run Text="{Binding ActiveWorkflows, Mode=OneWay}" Foreground="{StaticResource B.Success}"/><Run Text=" 활성 · "/><Run Text="{Binding DisabledWorkflows, Mode=OneWay}"/><Run Text=" 비활성"/>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Row 2: runtime/infra cards -->
            <UniformGrid Columns="4" Rows="1" Margin="0,0,0,16">
                <Button Style="{StaticResource DashCard}" Command="{Binding NavigateToCommand}" CommandParameter="MCP" Margin="0,0,8,0" ToolTip="→ MCP 모듈">
                    <StackPanel>
                        <TextBlock Text="MCP" Style="{StaticResource T.Pixel.Section}" FontSize="9"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding OnlineMcp}" FontFamily="{StaticResource Font.CRT}" FontSize="42" Foreground="{StaticResource B.Success}" Effect="{StaticResource Glow.Soft}"/>
                            <TextBlock Text="/" FontFamily="{StaticResource Font.CRT}" FontSize="34" Foreground="{StaticResource B.TextDim}" Margin="6,4,6,0"/>
                            <TextBlock Text="{Binding TotalMcp}" FontFamily="{StaticResource Font.CRT}" FontSize="42" Foreground="{StaticResource B.Text}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource T.Muted}">
                            <Run Text="{Binding DisabledMcp, Mode=OneWay}"/><Run Text=" disabled · "/>
                            <Run Text="{Binding AuthRequiredMcp, Mode=OneWay}"/><Run Text=" auth"/>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DashCard}" Command="{Binding NavigateToCommand}" CommandParameter="SESSIONS" Margin="4,0,4,0" ToolTip="→ SESSIONS 모듈">
                    <StackPanel>
                        <TextBlock Text="SESSIONS" Style="{StaticResource T.Pixel.Section}" FontSize="9"/>
                        <TextBlock Text="{Binding SessionsFileCount}" Style="{StaticResource T.CRT.Stat}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding SessionsTotalSize}" Style="{StaticResource T.Muted}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DashCard}" Command="{Binding NavigateToCommand}" CommandParameter="SNAP" Margin="4,0,4,0" ToolTip="→ SNAPSHOTS 모듈">
                    <StackPanel>
                        <TextBlock Text="SNAPSHOTS" Style="{StaticResource T.Pixel.Section}" FontSize="9"/>
                        <TextBlock Text="{Binding SnapshotCount}" Style="{StaticResource T.CRT.Stat}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding LastSnapshot}" Style="{StaticResource T.Muted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource DashCard}" Command="{Binding NavigateToCommand}" CommandParameter="DIAG" Margin="8,0,0,0" ToolTip="→ DIAGNOSTICS 모듈">
                    <StackPanel>
                        <TextBlock Text="DIAGNOSTICS" Style="{StaticResource T.Pixel.Section}" FontSize="9"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding DiagErrors}" FontFamily="{StaticResource Font.CRT}" FontSize="42" Foreground="{StaticResource B.Danger}" Effect="{StaticResource Glow.Soft}"/>
                            <TextBlock Text="/" FontFamily="{StaticResource Font.CRT}" FontSize="34" Foreground="{StaticResource B.TextDim}" Margin="6,4,6,0"/>
                            <TextBlock Text="{Binding DiagWarnings}" FontFamily="{StaticResource Font.CRT}" FontSize="42" Foreground="{StaticResource B.Warn}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource T.Muted}">
                            <Run Text="err · warn  ("/>
                            <Run Text="{Binding DiagInfo, Mode=OneWay}"/>
                            <Run Text=" info)"/>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- STORAGE / SESSIONS CARD -->
            <Border Style="{StaticResource Panel.Rust}" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◢ SESSION STORAGE" Style="{StaticResource T.Pixel.Section}"/>
                            <TextBlock Text="{Binding SessionsWarningLevel}" FontFamily="{StaticResource Font.Pixel}" FontSize="7" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource B.Success}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SessionsWarningLevel}" Value="WARN"><Setter Property="Foreground" Value="{StaticResource B.Warn}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding SessionsWarningLevel}" Value="DANGER"><Setter Property="Foreground" Value="{StaticResource B.Danger}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="  ▌  ~/.claude/projects/" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SessionsTotalSize}" Style="{StaticResource T.CRT.Stat}" FontSize="36" Foreground="{StaticResource B.Ember}" Effect="{StaticResource Glow.Soft}"/>
                            <TextBlock Text="disk used" Style="{StaticResource T.Muted}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding SessionsFileCount}" Style="{StaticResource T.CRT.Stat}" FontSize="36"/>
                            <TextBlock Text=".jsonl files" Style="{StaticResource T.Muted}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding CleanupPeriod}" Style="{StaticResource T.CRT.Heading}" FontSize="24"/>
                            <TextBlock Text="cleanupPeriodDays" Style="{StaticResource T.Muted}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="{Binding SessionsOldest}" Style="{StaticResource T.Mono}" FontSize="14"/>
                            <TextBlock Text="{Binding SessionsNewest}" Style="{StaticResource T.Muted}"/>
                            <TextBlock Text="oldest / newest" Style="{StaticResource T.Muted}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Top 5 projects table -->
                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <TextBlock Text="TOP PROJECTS" Style="{StaticResource T.Pixel.Section}" FontSize="8"/>
                        <ItemsControl ItemsSource="{Binding TopProjects}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Slug}" FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource B.Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <!-- Relative comparison bar (largest project = 100%). Hidden when only 1 project — meaningless. -->
                                        <Border Grid.Column="1" Height="3" Background="{StaticResource B.BorderSoft}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                Visibility="{Binding DataContext.ShowRelativeBars, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static vm:BoolToVisibility.Instance}}"
                                                ToolTip="relative size vs largest project (comparison only, not a capacity limit)">
                                            <Border HorizontalAlignment="Left" Background="{StaticResource B.RustDim}" Opacity="0.7"
                                                    Width="{Binding BarPct, Converter={x:Static vm:PercentToWidthConverter.Instance}, ConverterParameter=172}"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" FontFamily="{StaticResource Font.Mono}" Foreground="{StaticResource B.TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Run Text="{Binding SessionCount, Mode=OneWay}"/><Run Text=" sessions"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontFamily="{StaticResource Font.CRT}" FontSize="16" Foreground="{StaticResource B.Ember}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Panel.Rust}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="◢ ENVIRONMENT" Style="{StaticResource T.Pixel.Section}"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource T.Muted}" Text="~/.claude/"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource T.Mono}" Text="{Binding ClaudeRoot}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource T.Muted}" Text="snapshots/"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource T.Mono}" Text="{Binding SnapshotRoot}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource T.Muted}" Text="settings.json"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource T.Mono}" Text="{Binding SettingsExists}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource T.Muted}" Text="settings.local.json"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource T.Mono}" Text="{Binding LocalSettingsExists}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Panel.Rust}" Margin="8,0,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="◢ TOP DIAGNOSTICS" Style="{StaticResource T.Pixel.Section}"/>
                        <ItemsControl ItemsSource="{Binding TopDiagnostics}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource B.BorderSoft}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Severity}" FontFamily="{StaticResource Font.Pixel}" FontSize="7" Width="64" VerticalAlignment="Top">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource B.TextMuted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Error"><Setter Property="Foreground" Value="{StaticResource B.Danger}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Warning"><Setter Property="Foreground" Value="{StaticResource B.Warn}"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource T.Body}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Category}" Style="{StaticResource T.Muted}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
