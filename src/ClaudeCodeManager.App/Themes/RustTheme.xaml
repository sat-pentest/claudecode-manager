<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════
         RUST PALETTE  ·  CLAUDE CODE MANAGER
         ═══════════════════════════════════════════════════════ -->

    <Color x:Key="C.BG.Primary">#FF0A0908</Color>
    <Color x:Key="C.BG.Panel">#FF14110F</Color>
    <Color x:Key="C.BG.Sunken">#FF050403</Color>
    <Color x:Key="C.BG.Hover">#FF1F1A16</Color>
    <Color x:Key="C.Rust">#FFD9441C</Color>
    <Color x:Key="C.Ember">#FFF26A2E</Color>
    <Color x:Key="C.RustDim">#FF7A2812</Color>
    <Color x:Key="C.Border">#FF4A1F0E</Color>
    <Color x:Key="C.BorderSoft">#FF2A1408</Color>
    <Color x:Key="C.Text">#FFE8DDD0</Color>
    <Color x:Key="C.TextMuted">#FF9A8A78</Color>
    <Color x:Key="C.TextDim">#FF5A4F44</Color>
    <Color x:Key="C.Danger">#FFB22020</Color>
    <Color x:Key="C.Success">#FF6FA844</Color>
    <Color x:Key="C.Warn">#FFD9A02C</Color>

    <!-- Row highlight tints for status differentiation -->
    <Color x:Key="C.Row.Inactive">#FF231A0F</Color>
    <Color x:Key="C.Row.Disabled">#FF1A0C09</Color>

    <SolidColorBrush x:Key="B.BG.Primary" Color="{StaticResource C.BG.Primary}"/>
    <SolidColorBrush x:Key="B.BG.Panel" Color="{StaticResource C.BG.Panel}"/>
    <SolidColorBrush x:Key="B.BG.Sunken" Color="{StaticResource C.BG.Sunken}"/>
    <SolidColorBrush x:Key="B.BG.Hover" Color="{StaticResource C.BG.Hover}"/>
    <SolidColorBrush x:Key="B.Rust" Color="{StaticResource C.Rust}"/>
    <SolidColorBrush x:Key="B.Ember" Color="{StaticResource C.Ember}"/>
    <SolidColorBrush x:Key="B.RustDim" Color="{StaticResource C.RustDim}"/>
    <SolidColorBrush x:Key="B.Border" Color="{StaticResource C.Border}"/>
    <SolidColorBrush x:Key="B.BorderSoft" Color="{StaticResource C.BorderSoft}"/>
    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}"/>
    <SolidColorBrush x:Key="B.TextMuted" Color="{StaticResource C.TextMuted}"/>
    <SolidColorBrush x:Key="B.TextDim" Color="{StaticResource C.TextDim}"/>
    <SolidColorBrush x:Key="B.Danger" Color="{StaticResource C.Danger}"/>
    <SolidColorBrush x:Key="B.Success" Color="{StaticResource C.Success}"/>
    <SolidColorBrush x:Key="B.Warn" Color="{StaticResource C.Warn}"/>
    <SolidColorBrush x:Key="B.Row.Inactive" Color="{StaticResource C.Row.Inactive}"/>
    <SolidColorBrush x:Key="B.Row.Disabled" Color="{StaticResource C.Row.Disabled}"/>

    <!-- ═══════════════════════════════════════════════════════
         TYPOGRAPHY
         ═══════════════════════════════════════════════════════ -->

    <FontFamily x:Key="Font.Pixel">pack://application:,,,/Fonts/#Press Start 2P</FontFamily>
    <FontFamily x:Key="Font.CRT">pack://application:,,,/Fonts/#VT323</FontFamily>
    <FontFamily x:Key="Font.Mono">pack://application:,,,/Fonts/#IBM Plex Sans KR, Segoe UI, Malgun Gothic, Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Font.UI">pack://application:,,,/Fonts/#IBM Plex Sans KR, Segoe UI, Malgun Gothic</FontFamily>

    <!-- ═══════════════════════════════════════════════════════
         EFFECTS
         ═══════════════════════════════════════════════════════ -->

    <DropShadowEffect x:Key="Glow.Ember" Color="{StaticResource C.Ember}" BlurRadius="14" ShadowDepth="0" Opacity="0.75"/>
    <DropShadowEffect x:Key="Glow.Rust" Color="{StaticResource C.Rust}" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
    <DropShadowEffect x:Key="Glow.Soft" Color="{StaticResource C.RustDim}" BlurRadius="6" ShadowDepth="0" Opacity="0.45"/>

</ResourceDictionary>
