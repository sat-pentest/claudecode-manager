<?xml version="1.0"?>
<SyntaxDefinition name="MarkdownRust" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">

  <Color name="Heading1"       foreground="#F26A2E" fontWeight="bold"/>
  <Color name="Heading2"       foreground="#D9441C" fontWeight="bold"/>
  <Color name="HeadingN"       foreground="#D9A02C" fontWeight="bold"/>
  <Color name="Bold"           foreground="#F26A2E" fontWeight="bold"/>
  <Color name="Code"           foreground="#D9A02C"/>
  <Color name="CodeBlock"      foreground="#D9A02C"/>
  <Color name="CodeFence"      foreground="#7A2812" fontWeight="bold"/>
  <Color name="Link"           foreground="#6FA844"/>
  <Color name="LinkUrl"        foreground="#7A8B5E" fontStyle="italic"/>
  <Color name="Blockquote"     foreground="#9A8A78" fontStyle="italic"/>
  <Color name="Frontmatter"    foreground="#9A8A78"/>
  <Color name="HtmlTag"        foreground="#7A8B5E"/>
  <Color name="Disabled"       foreground="#5A4F44" fontStyle="italic"/>
  <Color name="HtmlComment"    foreground="#7A6F64" fontStyle="italic"/>

  <RuleSet ignoreCase="false">

    <!-- CCM-DISABLED marker line — dim to fade disabled entries into background -->
    <Span color="Disabled">
      <Begin>&lt;!--\s*CCM-DISABLED</Begin>
      <End>--&gt;</End>
    </Span>

    <!-- Generic HTML comment -->
    <Span color="HtmlComment">
      <Begin>&lt;!--</Begin>
      <End>--&gt;</End>
    </Span>

    <!-- Fenced code block (multiline) -->
    <Span color="CodeBlock" multiline="true">
      <Begin color="CodeFence">^```</Begin>
      <End color="CodeFence">^```</End>
    </Span>

    <!-- YAML frontmatter (top of file only via \A) -->
    <Span color="Frontmatter" multiline="true">
      <Begin>\A---</Begin>
      <End>^---</End>
    </Span>

    <!-- Headings — longest prefix first to avoid sub-matching -->
    <Span color="HeadingN">
      <Begin>^\#{3,6}[ \t]</Begin>
      <End>$</End>
    </Span>
    <Span color="Heading2">
      <Begin>^\#\#[ \t]</Begin>
      <End>$</End>
    </Span>
    <Span color="Heading1">
      <Begin>^\#[ \t]</Begin>
      <End>$</End>
    </Span>

    <!-- Blockquote -->
    <Span color="Blockquote">
      <Begin>^&gt;</Begin>
      <End>$</End>
    </Span>

    <!-- Bold **text** -->
    <Span color="Bold">
      <Begin>\*\*</Begin>
      <End>\*\*</End>
    </Span>

    <!-- Inline code `text` -->
    <Span color="Code">
      <Begin>`</Begin>
      <End>`</End>
    </Span>

    <!-- Link [label] -->
    <Rule color="Link">\[[^\]]+?\]</Rule>

    <!-- Link url (...) — after Link rule -->
    <Rule color="LinkUrl">\([^)\s]+?\)</Rule>

    <!-- HTML tag -->
    <Rule color="HtmlTag">&lt;/?[A-Za-z][^&gt;]*&gt;</Rule>

  </RuleSet>
</SyntaxDefinition>
