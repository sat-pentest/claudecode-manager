<?xml version="1.0"?>
<SyntaxDefinition name="MarkdownRust" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">

  <Color name="Heading1" foreground="#F26A2E" fontWeight="bold"/>
  <Color name="Heading2" foreground="#FF9A6B" fontWeight="bold"/>
  <Color name="HeadingN" foreground="#E6AC3C" fontWeight="bold"/>
  <Color name="Bold" foreground="#F1ECE6" fontWeight="bold"/>
  <Color name="Code" foreground="#E6AC3C"/>
  <Color name="CodeBlock" foreground="#D8D2CA"/>
  <Color name="CodeFence" foreground="#746B63"/>
  <Color name="Link" foreground="#FF9A6B"/>
  <Color name="LinkUrl" foreground="#6F665D"/>
  <Color name="Blockquote" foreground="#AAA096" fontStyle="italic"/>
  <Color name="Frontmatter" foreground="#8A8178"/>
  <Color name="HtmlTag" foreground="#746B63"/>
  <Color name="Disabled" foreground="#4E4640" fontStyle="italic"/>
  <Color name="HtmlComment" foreground="#5E564F" fontStyle="italic"/>

  <RuleSet ignoreCase="false">

    <!-- CCM-DISABLED marker line — dim to fade disabled entries into background -->
    <Span color="Disabled">
      <Begin>&lt;!--\s*CCM-DISABLED</Begin>
      <End>--&gt;</End>
    </Span>

    <!-- Generic HTML comment -->
    <Span color="HtmlComment">
      <Begin>&lt;!--</Begin>
      <End>--&gt;</End>
    </Span>

    <!-- Fenced code block (multiline) -->
    <Span color="CodeBlock" multiline="true">
      <Begin color="CodeFence">^```</Begin>
      <End color="CodeFence">^```</End>
    </Span>

    <!-- YAML frontmatter (top of file only via \A) -->
    <Span color="Frontmatter" multiline="true">
      <Begin>\A---</Begin>
      <End>^---</End>
    </Span>

    <!-- Headings — longest prefix first to avoid sub-matching -->
    <Span color="HeadingN">
      <Begin>^\#{3,6}[ \t]</Begin>
      <End>$</End>
    </Span>
    <Span color="Heading2">
      <Begin>^\#\#[ \t]</Begin>
      <End>$</End>
    </Span>
    <Span color="Heading1">
      <Begin>^\#[ \t]</Begin>
      <End>$</End>
    </Span>

    <!-- Blockquote -->
    <Span color="Blockquote">
      <Begin>^&gt;</Begin>
      <End>$</End>
    </Span>

    <!-- Bold **text** -->
    <Span color="Bold">
      <Begin>\*\*</Begin>
      <End>\*\*</End>
    </Span>

    <!-- Inline code `text` -->
    <Span color="Code">
      <Begin>`</Begin>
      <End>`</End>
    </Span>

    <!-- Link [label] -->
    <Rule color="Link">\[[^\]]+?\]</Rule>

    <!-- Link url (...) — after Link rule -->
    <Rule color="LinkUrl">\([^)\s]+?\)</Rule>

    <!-- HTML tag -->
    <Rule color="HtmlTag">&lt;/?[A-Za-z][^&gt;]*&gt;</Rule>

  </RuleSet>
</SyntaxDefinition>
